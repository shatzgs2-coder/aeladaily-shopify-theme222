<div class="product-card" data-product-handle="{{ product.handle }}">
  <div class="product-card__image-wrapper">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 600 | image_tag:
        loading: 'lazy',
        widths: '300,450,600',
        alt: product.title
      }}
    {% else %}
      <div style="width:100%;height:100%;background:var(--aw-linen);display:flex;align-items:center;justify-content:center;font-family:'Cormorant Garamond',serif;color:var(--aw-wheat);font-size:1rem;">{{ product.title }}</div>
    {% endif %}

    {% if product.compare_at_price > product.price %}
      <span class="product-card__badge">Sale</span>
    {% elsif product.available == false %}
      <span class="product-card__badge">Sold Out</span>
    {% endif %}

    <!-- Quick Add (only for variants) -->
    {% if product.has_only_default_variant == false and product.available %}
      {%- assign first_variant = product.selected_or_first_available_variant -%}
      <div style="position:absolute;bottom:12px;left:12px;right:12px;">
        <button type="button"
          class="btn--quick-add"
          data-variant-id="{{ first_variant.id }}"
          onclick="fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:{{first_variant.id}},quantity:1})}).then(r=>{if(r.ok){this.textContent='Added ✓';setTimeout(()=>this.textContent='Quick Add',1500)}}).catch(()=>{this.textContent='Error';setTimeout(()=>this.textContent='Quick Add',2000)})">
          Quick Add
        </button>
      </div>
    {% endif %}
  </div>

  <div class="product-card__info">
    <span class="product-card__type">{{ product.type | default: 'Home Decor' }}</span>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="product-card__price price--current">
      {{ product.price | money }}
      {% if product.compare_at_price > product.price %}
        <span class="price--compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </p>
  </div>
</div>
