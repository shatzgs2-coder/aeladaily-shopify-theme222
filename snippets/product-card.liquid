<div class="aw-product-card">
  <a href="{{ product.url }}" class="aw-product-card__link">
    <div class="aw-product-card__img">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 450 | image_tag: loading:'lazy', alt:product.title }}
      {%- else -%}
        <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#c4a882;font-family:'Cormorant Garamond',serif;">Atelier Wabi</div>
      {%- endif -%}
    </div>
    <div class="aw-product-card__body">
      <p class="aw-product-card__type">{{ product.type | default: 'Home Decor' }}</p>
      <h3 class="aw-product-card__title">{{ product.title }}</h3>
      <p class="aw-product-card__price">{{ product.price | money }}</p>
    </div>
  </a>
</div>
