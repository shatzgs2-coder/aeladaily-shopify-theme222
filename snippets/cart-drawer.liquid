<!-- Cart Drawer (Slide-in Panel) -->
<div class="aw-cart-drawer" id="aw-cart-drawer" aria-hidden="true">
  <div class="aw-cart-drawer__header">
    <h3>Your Cart <span class="aw-cart-count" style="font-weight:400;color:var(--aw-stone)">({{ cart.item_count }})</span></h3>
    <button type="button" class="aw-cart-drawer__close" aria-label="Close cart">&times;</button>
  </div>

  <!-- Items rendered by JS -->
  <div class="aw-cart-drawer__body" id="aw-cart-items">
    <div class="aw-cart-empty">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#d4c4b0" stroke-width="1">
        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
      </svg>
      <p>Your cart is empty</p>
    </div>
  </div>

  <!-- Footer -->
  <div class="aw-cart-drawer__footer" id="aw-cart-footer"></div>
</div>
<!-- Overlay -->
<div class="aw-cart-drawer__overlay" id="aw-cart-overlay"></div>
