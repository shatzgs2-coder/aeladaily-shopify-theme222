<div class="cart-drawer" id="cart-drawer" hidden>
  <div class="cart-drawer__overlay"></div>
  <div class="cart-drawer__inner">
    <div class="cart-drawer__header">
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.25rem;color:var(--aw-charcoal);margin:0;">Your Cart</h2>
      <button type="button" class="cart-drawer__close" aria-label="Close">&times;</button>
    </div>

    <div class="cart-drawer__body">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="drawer-item">
            {% if item.image %}
              {{ item.image | image_url: width: 128 | image_tag:
                loading: 'lazy',
                alt: item.title,
                style: 'border-radius:4px;'
              }}
            {% endif %}
            <div class="drawer-item__info">
              <p>{{ item.product.title }}</p>
              <span>{{ item.quantity }} &times; {{ item.final_price | money }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p style="text-align:center;color:var(--aw-stone);padding:40px 0;">Your cart is empty</p>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__footer">
        <p style="display:flex;justify-content:space-between;font-weight:600;">
          <span>Subtotal:</span><span>{{ cart.total_price | money }}</span>
        </p>
        <a href="{{ routes.cart_url }}" class="btn btn--primary btn--block">View Cart</a>
        <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="btn btn--outline btn--block" style="margin-top:8px;">Checkout</button></form>
      </div>
    {% endif %}
  </div>
</div>
