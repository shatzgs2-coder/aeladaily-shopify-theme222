<style>
.aw-hero{position:relative;overflow:hidden;background:#F2EFE8}
.aw-hero__inner{max-width:1280px;margin:0 auto;padding:120px 40px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;min-height:600px}
.aw-hero__content{display:flex;flex-direction:column;gap:24px}
.aw-hero__label{font-size:.75rem;text-transform:uppercase;letter-spacing:3px;color:#7A8471;font-weight:500}
.aw-hero__title{font-family:var(--aw-font-heading);font-size:3.5rem;font-weight:500;line-height:1.15;color:#1F1B16;margin:0}
.aw-hero__subtitle{font-size:1.08rem;color:#5C5648;line-height:1.7;font-weight:300;max-width:480px}
.aw-hero__actions{display:flex;gap:16px;flex-wrap:wrap;margin-top:8px}
.aw-hero__img{border-radius:12px;overflow:hidden;aspect-ratio:4/5;background:#E8E4DD}
.aw-hero__img img{width:100%;height:100%;object-fit:cover}
@media(max-width:968px){
  .aw-hero__inner{grid-template-columns:1fr;padding:80px 24px;min-height:auto;gap:40px;text-align:center}
  .aw-hero__subtitle{margin:0 auto;max-width:100%}
  .aw-hero__actions{justify-content:center}
  .aw-hero__title{font-size:2.4rem}
  .aw-hero__img{aspect-ratio:1/1;max-width:400px;margin:0 auto}
}
</style>

<section class="aw-hero">
  <div class="aw-hero__inner">
    <div class="aw-hero__content">
      {%- if section.settings.label != blank -%}
        <span class="aw-hero__label">{{ section.settings.label }}</span>
      {%- endif -%}
      <h1 class="aw-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="aw-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      <div class="aw-hero__actions">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="aw-btn aw-btn--primary">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="aw-btn aw-btn--outline">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.image != blank -%}
      <div class="aw-hero__img">
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'eager', alt: section.settings.heading, widths: '400,600,800,1200' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "class": "section-hero",
  "settings": [
    {"type": "text","id": "label","label": "Label","default": "Est. 2026 | Berlin, Germany"},
    {"type": "text","id": "heading","label": "Heading","default": "Handcrafted Wabi-Sabi Home Decor"},
    {"type": "textarea","id": "subtitle","label": "Subtitle","default": "Each piece tells a story of imperfection and authenticity. Discover our collection of handmade textiles and natural decor for mindful living."},
    {"type": "text","id": "cta_text","label": "Primary button","default": "Shop Collection"},
    {"type": "url","id": "cta_link","label": "Primary link","default": "/collections/all"},
    {"type": "text","id": "cta2_text","label": "Secondary button","default": "Our Story"},
    {"type": "url","id": "cta2_link","label": "Secondary link","default": "/pages/about"},
    {"type": "image_picker","id": "image","label": "Hero image"}
  ],
  "presets": [{"name": "Hero Banner", "category": "Hero"}]
}
{% endschema %}
