<div class="hero hero--{{ section.settings.height }}">
  <div class="hero__bg{% if section.settings.bg_image %} hero__bg--image{% endif %}">
    {% if section.settings.bg_image %}
      <img
        src="{{ section.settings.bg_image | image_url: width: 1920 }}"
        alt="{{ section.settings.heading | escape }}"
        class="hero__image"
        loading="eager"
        width="1920"
        height="{{ 1920 | divided_by: section.settings.bg_image.aspect_ratio | round }}"
      >
      <div class="hero__overlay" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
    {% endif %}
  </div>
  <div class="page-width hero__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h1 class="hero__title" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </h1>
        {%- when 'text' -%}
          <p class="hero__subtitle" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </p>
        {%- when 'buttons' -%}
          <div class="hero__actions" {{ block.shopify_attributes }}>
            {% if block.settings.btn_label_1 %}
              <a href="{{ block.settings.btn_link_1 | default: '#'}}" class="btn btn--primary">
                {{ block.settings.btn_label_1 }}
              </a>
            {% endif %}
            {% if block.settings.btn_label_2 %}
              <a href="{{ block.settings.btn_link_2 | default: '#'}}" class="btn btn--outline">
                {{ block.settings.btn_label_2 }}
              </a>
            {% endif %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "options": [
        {"value": "small", "label": "Small"},
        {"value": "medium", "label": "Medium (Recommended)"},
        {"value": "large", "label": "Large"}
      ],
      "default": "medium",
      "label": "Section height"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%",
      "label": "Overlay opacity"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Embrace Wabi-Sabi Living",
          "label": "Heading text"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "default": "Curated home decor & lifestyle pieces that celebrate imperfection and authenticity.",
          "label": "Subheading"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "btn_label_1",
          "default": "Shop Collection",
          "label": "Button 1 label"
        },
        {
          "type": "url",
          "id": "btn_link_1",
          "label": "Button 1 link"
        },
        {
          "type": "text",
          "id": "btn_label_2",
          "default": "Our Story",
          "label": "Button 2 label"
        },
        {
          "type": "url",
          "id": "btn_link_2",
          "label": "Button 2 link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {"type": "heading", "settings": {}},
        {"type": "text", "settings": {}},
        {"type": "buttons", "settings": {}}
      ]
    }
  ]
}
{% endschema %}
