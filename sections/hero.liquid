<style>
  .aw-hero { position:relative;min-height:90vh;display:flex;align-items:center;justify-content:center;overflow:hidden;text-align:center;color:#fff; }
  .aw-hero__bg { position:absolute;inset:0;z-index:0;background:linear-gradient(135deg,#3d342b 0%,#5c4a38 50%,#8b7355 100%); }
  .aw-hero__bg img,.aw-hero__bg video { width:100%;height:100%;object-fit:cover; }
  .aw-hero__overlay {
    position:absolute;inset:0;z-index:1;
    background:linear-gradient(135deg,rgba(44,40,37,0.78) 0%,rgba(44,40,37,0.45) 50%,rgba(139,115,85,0.30) 100%);
  }
  /* Decorative circles */
  .aw-hero__deco{position:absolute;border-radius:50%;opacity:.08;z-index:1;background:radial-gradient(circle,var(--aw-terracotta) 0%,transparent 70%)}
  .aw-hero__deco--1{width:500px;height:500px;top:-120px;right:-80px}
  .aw-hero__deco--2{width:350px;height:350px;bottom:-80px;left:-60px;animation:heroFloat 7s ease-in-out infinite}
  @keyframes heroFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-20px)}}

  .aw-hero__content{position:relative;z-index:2;max-width:720px;margin:0 auto;padding:0 28px;}
  .aw-hero__eyebrow{font-size:.75rem;text-transform:uppercase;letter-spacing:4px;color:var(--aw-clay);margin-bottom:18px;font-weight:500;}
  .aw-hero__title{
    font-family:var(--font-heading);font-size:clamp(2.6rem,6vw,4.5rem);color:#fff;
    line-height:1.08;margin-bottom:24px;font-weight:600;text-shadow:0 2px 20px rgba(0,0,0,0.15);
  }
  .aw-hero__subtitle{font-size:1.1rem;color:rgba(255,255,255,0.85);line-height:1.75;max-width:520px;margin:0 auto 40px;font-weight:300;}
  .aw-hero__ctas{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;}

  .aw-hero__scroll-hint{
    position:absolute;bottom:36px;left:50%;transform:translateX(-50%);
    z-index:2;display:flex;flex-direction:column;align-items:center;gap:6px;
    color:rgba(255,255,255,0.5);font-size:.72rem;letter-spacing:2px;text-transform:uppercase;
    animation:bounce 2s infinite;
  }
  .aw-hero__scroll-hint span{width:1px;height:36px;background:rgba(255,255,255,0.25);position:relative;}
  .aw-hero__scroll-hint span::after{content:'';position:absolute;top:0;left:-2px;width:5px;height:5px;background:rgba(255,255,255,0.55);border-radius:50%;animation:scrollDot 2s infinite}
  @keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(8px)}}
  @keyframes scrollDot{0%{top:0;opacity:1}100%{top:28px;opacity:0}}

  @media(max-width:768px){.aw-hero{min-height:80vh}.aw-hero__content{padding:0 16px}.aw-hero__title{font-size:clamp(2rem,8vw,3.2rem)}}
</style>

<section class="aw-hero aw-fade-up">
  <!-- Background -->
  <div class="aw-hero__bg">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 1920 | image_tag:
        loading:'eager', widths:'400,800,1200,1600,1920',
        alt: section.settings.heading,
        style:'width:100%;height:100%;object-fit:cover'
      }}
    {%- endif -%}
  </div>
  <div class="aw-hero__overlay"></div>

  <!-- Decorative Elements -->
  <div class="aw-hero__deco aw-hero__deco--1"></div>
  <div class="aw-hero__deco aw-hero__deco--2"></div>

  <!-- Content -->
  <div class="aw-hero__content">
    <p class="aw-hero__eyebrow">{{ section.settings.eyebrow | default: 'Est. 2026 · Berlin' }}</p>
    <h1 class="aw-hero__title">{{ section.settings.heading }}</h1>
    <p class="aw-hero__subtitle">{{ section.settings.subtitle }}</p>
    <div class="aw-hero__ctas">
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link | default: routes.collections_url }}" class="aw-btn aw-btn--primary">
          {{ section.settings.cta_text }}
        </a>
      {% endif %}
      {% if section.settings.cta2_text != blank %}
        <a href="{{ section.settings.cta2_link | default: pages['about-us'].url }}" class="aw-btn aw-btn--outline" style="border-color:#fff;color:#fff;">
          {{ section.settings.cta2_text }}
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Scroll Hint -->
  <div class="aw-hero__scroll-hint"><span></span>Scroll</div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "aw-hero-section",
  "settings": [
    { "type":"image_picker", "id":"bg_image", "label":"Background Image", "info":"Recommended: 1920x1080 or larger" },
    { "type":"text","id":"eyebrow","label":"Eyebrow Text","default":"Est. 2026 · Berlin" },
    { "type":"text","id":"heading","label":"Main Heading","default":"Handcrafted Home Decor" },
    { "type":"textarea","id":"subtitle","label":"Subtitle","default":"Discover our collection of handmade textiles, ceramics & natural decor — each piece tells a story of wabi-sabi beauty." },
    { "type":"text","id":"cta_text","label":"Primary Button","default":"Shop Collection" },
    { "type":"url","id":"cta_link","label":"Primary Link" },
    { "type":"text","id":"cta2_text","label":"Secondary Button","default":"Our Story" },
    { "type":"url","id":"cta2_link","label":"Secondary Link" }
  ],
  "presets":[
    {"name":"Hero Banner","category":"Hero"}
  ]
}
{% endschema %}
