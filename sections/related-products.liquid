{%- assign product = product -%}

<style>
  .aw-related{padding:var(--spacing-xl) 40px;background:var(--aw-wheat)}
  .aw-related__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:48px}
  @media(max-width:1024px){.aw-related__grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:768px){.aw-related{padding:var(--spacing-lg)20px}.aw-related__grid{grid-template-columns:repeat(2,1fr);gap:14px}}
</style>

<section class="aw-related">
  <div class="aw-container">
    <p class="aw-label">{{ section.settings.label | default: 'Complete the Look' }}</p>
    <h2>{{ section.settings.title | default: 'You May Also Like' }}</h2>
    <div class="aw-related__grid">
      {%- for i in (1..section.settings.products_count) -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}{ "name":"Related Products","tag":"section","settings":[{"type":"text","id":"title","label":"Heading","default":"You May Also Like"},{"type":"text","id":"label","label":"Label"},{"type":"range","id":"products_count","label":"Products to show","min":2,"max":8,"default":4}],"presets":[{"name":"Related Products"}] }{% endschema %}
