<style>
.aw-rel{padding:80px 40px;background:#fff}
.aw-rel__inner{max-width:1280px;margin:0 auto}
.aw-rel__heading{font-family:var(--aw-font-heading);font-size:1.8rem;font-weight:500;color:#1F1B16;text-align:center;margin:0 0 40px}
.aw-rel__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
@media(max-width:1024px){.aw-rel__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.aw-rel{padding:48px 20px}.aw-rel__grid{grid-template-columns:repeat(2,1fr);gap:16px}}
</style>

{%- if recommendations.performed -%}
  {%- if recommendations.products_count > 0 -%}
    <section class="aw-rel">
      <div class="aw-rel__inner">
        <h2 class="aw-rel__heading">{{ section.settings.heading }}</h2>
        <div class="aw-rel__grid">
          {%- for product in recommendations.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- else -%}
  <div class="aw-rel" data-base-url="{{ routes.product_recommendations_url }}" data-product-id="{{ product.id }}" data-section-type="product-recommendations">
    <div class="aw-rel__inner" data-recommendations-container>
      <h2 class="aw-rel__heading">{{ section.settings.heading }}</h2>
      <div class="aw-rel__grid" data-recommendations-grid></div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Related Products",
  "class": "section-related-products",
  "settings": [
    {"type": "text","id": "heading","label": "Heading","default": "You May Also Like"}
  ],
  "presets": [{"name": "Related Products", "category": "Product"}]
}
{% endschema %}
