<section class="aw-philosophy">
  <div class="aw-philosophy__inner">
    <p class="aw-label">{{ section.settings.label | default: "Our Philosophy" }}</p>
    <blockquote class="aw-philosophy__quote">{{ section.settings.quote | default: "Wabi-sabi is not a style. It is a way of seeing — a quiet appreciation for the worn, the weathered, the simply beautiful." }}</blockquote>
    <p class="aw-philosophy__text">{{ section.settings.text | default: "From hand-knotted table runners to cotton rope baskets, our collection invites you to slow down. To fill your home with textures that feel good. To celebrate the imperfect, the handmade, and the real." }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy Quote",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Our Philosophy" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "textarea", "id": "text", "label": "Supporting Text" }
  ],
  "presets": [{ "name": "Philosophy Quote", "category": "Text" }]
}
{% endschema %}
