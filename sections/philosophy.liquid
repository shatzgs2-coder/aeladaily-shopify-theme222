<style>
.aw-phil{padding:80px 40px;background:#FAFAF7;text-align:center}
.aw-phil__inner{max-width:720px;margin:0 auto}
.aw-phil__label{font-size:.75rem;text-transform:uppercase;letter-spacing:3px;color:#7A8471;font-weight:500;margin-bottom:16px;display:block}
.aw-phil__quote{font-family:var(--aw-font-heading);font-size:2rem;font-weight:400;font-style:italic;color:#8B6F47;line-height:1.6;margin:0 0 20px}
.aw-phil__author{font-size:.9rem;color:#5C5648;font-weight:300}
@media(max-width:768px){.aw-phil{padding:56px 24px}.aw-phil__quote{font-size:1.4rem}}
</style>

<section class="aw-phil">
  <div class="aw-phil__inner">
    <span class="aw-phil__label">{{ section.settings.label }}</span>
    <blockquote class="aw-phil__quote">{{ section.settings.quote }}</blockquote>
    {%- if section.settings.author != blank -%}
      <p class="aw-phil__author">{{ section.settings.author }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Philosophy Quote",
  "class": "section-philosophy",
  "settings": [
    {"type": "text","id": "label","label": "Label","default": "Our Philosophy"},
    {"type": "textarea","id": "quote","label": "Quote","default": "Imperfection is not a flaw. It is a reminder that in a world of mass production, the beauty of the human hand remains irreplaceable."},
    {"type": "text","id": "author","label": "Author / Attribution","default": "Aela Daily Studio, Berlin"}
  ],
  "presets": [{"name": "Philosophy Quote", "category": "Text"}]
}
{% endschema %}
