<div class="cart-page">
  <div class="page-width">
    <h1 class="page-title">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        <table class="cart-table" role="table">
          <thead>
            <tr>
              <th scope="col">{{ 'sections.cart.headings.product' | t }}</th>
              <th scope="col">{{ 'sections.cart.headings.quantity' | t }}</th>
              <th scope="col">{{ 'sections.cart.headings.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
            <tr class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
              <td data-label="{{ 'sections.cart.headings.product' | t }}" class="cart-item__product">
                <a href="{{ item.url }}">
                  {% if item.image %}
                    <img
                      src="{{ item.image | image_url: width: 120 }}"
                      alt="{{ item.image.alt | default: item.title | escape }}"
                      loading="lazy"
                      width="120"
                      height="{{ 120 | divided_by: item.image.aspect_ratio | round }}"
                    >
                  {% endif %}
                </a>
                <div class="cart-item__info">
                  <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                  {%- if product.has_only_default_variant == false -%}
                    <p class="cart-item__variant">{%- for option in item.options -%}{{ option }}{%- unless forloop.last -%} / {%- endunless -%}{%- endfor -%}</p>
                  {%- endif -%}
                  {%- if item.selling_plan_allocation -%}
                    <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}
                  <button type="button" class="cart-item__remove" data-index="{{ item.index | plus: 1 }}">{{ 'sections.cart.remove_title' | t }}</button>
                </div>
              </td>
              <td data-label="{{ 'sections.cart.headings.quantity' | t }}">
                <quantity-input class="qty-selector qty-selector--small">
                  <button type="button" class="qty-btn" name="minus{{ item.index | plus: 1 }}">&minus;</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.product.quantity.label' | t }}">
                  <button type="button" class="qty-btn" name="plus{{ item.index | plus: 1 }}">&plus;</button>
                </quantity-input>
              </td>
              <td data-label="{{ 'sections.cart.headings.total' | t }}">
                <span class="price--current">{{ item.final_line_price | money }}</span>
              </td>
            </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-footer">
          <div class="cart-totals">
            <p class="cart-subtotal">Subtotal: <strong>{{ cart.total_price | money }}</strong></p>
            {%- capture taxes_shipping_checkout -%}
              {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- elsif cart.taxes_included -%}
                {{ 'sections.cart.taxes_included' | t }}
              {%- elsif shop.shipping_policy.body != blank -%}
                {{ 'sections.cart.taxes_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
              {%- else -%}
                {{ 'sections.cart.taxes_and_shipping' | t }}
              {%- endif -%}
            {%- endcapture -%}
            <p class="tax-note rte">{{ taxes_shipping_checkout }}</p>
          </div>
          <div class="cart-actions">
            <button type="submit" name="checkout" class="btn btn--primary btn--large">{{ 'sections.cart.checkout' | t }}</button>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Continue Shopping</a>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added anything yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue Shopping</a>
      </div>
    {%- endif -%}
  </div>
</div>

{{ 'section-main-cart.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "cart-section",
  "settings": [],
  "presets": [
    {
      "name": "Main Cart"
    }
  ]
}
{% endschema %}
