<style>
.aw-cart{padding:64px 40px;background:#FAFAF7;min-height:60vh}
.aw-cart__inner{max-width:900px;margin:0 auto}
.aw-cart h1{font-family:var(--aw-font-heading);font-size:2.4rem;font-weight:500;color:#1F1B16;margin:0 0 40px;text-align:center}
.aw-cart__empty{text-align:center;padding:80px 0;color:#5C5648}
.aw-cart__empty p{font-size:1.05rem;margin-bottom:24px}
.aw-cart__item{display:grid;grid-template-columns:100px 1fr auto auto;gap:20px;align-items:center;padding:20px 0;border-bottom:1px solid #E8E4DD}
.aw-cart__item-img{border-radius:8px;overflow:hidden;aspect-ratio:1/1;background:#F2EFE8}
.aw-cart__item-img img{width:100%;height:100%;object-fit:cover}
.aw-cart__item-info h3{font-family:var(--aw-font-heading);font-size:1.1rem;margin:0 0 4px;color:#1F1B16}
.aw-cart__item-info p{font-size:.82rem;color:#5C5648;margin:0}
.aw-cart__item-price{font-weight:500;color:#1F1B16}
.aw-cart__item-qty{width:56px;height:36px;text-align:center;border:1px solid #E8E4DD;border-radius:4px;font-size:.85rem}
.aw-cart__item-remove{background:none;border:none;color:#B89484;cursor:pointer;font-size:.8rem;text-decoration:underline}
.aw-cart__footer{margin-top:32px;text-align:right}
.aw-cart__total{font-size:1.2rem;font-weight:500;color:#1F1B16;margin-bottom:16px}
@media(max-width:768px){.aw-cart{padding:32px 20px}.aw-cart__item{grid-template-columns:80px 1fr;gap:12px}.aw-cart__item-price,.aw-cart__item-qty,.aw-cart__item-remove{font-size:.82rem}}
</style>

<section class="aw-cart">
  <div class="aw-cart__inner">
    <h1>Your Cart</h1>
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="aw-cart__item" data-line="{{ forloop.index }}">
          <div class="aw-cart__item-img">
            {%- if item.image -%}
              {{ item.image | image_url: width: 200 | image_tag: alt: item.title, widths: '100,200' }}
            {%- endif -%}
          </div>
          <div class="aw-cart__item-info">
            <h3><a href="{{ item.url }}" style="text-decoration:none;color:inherit">{{ item.product.title }}</a></h3>
            {%- unless item.product.has_only_default_variant -%}
              <p>{{ item.variant.title }}</p>
            {%- endunless -%}
          </div>
          <span class="aw-cart__item-price">{{ item.final_price | money }}</span>
          <div>
            <input type="number" class="aw-cart__item-qty" value="{{ item.quantity }}" min="0" data-line="{{ forloop.index }}">
            <a href="{{ item.url_to_remove }}" class="aw-cart__item-remove" style="display:block;margin-top:6px">Remove</a>
          </div>
        </div>
      {%- endfor -%}
      <div class="aw-cart__footer">
        <div class="aw-cart__total">Subtotal: {{ cart.total_price | money }}</div>
        <a href="/checkout" class="aw-btn aw-btn--primary">Checkout</a>
      </div>
    {%- else -%}
      <div class="aw-cart__empty">
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="aw-btn aw-btn--primary">Continue Shopping</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "class": "section-main-cart",
  "presets": [{"name": "Cart", "category": "Cart"}]
}
{% endschema %}
