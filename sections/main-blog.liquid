<section class="aw-blog-grid" style="padding:80px 40px;max-width:1280px;margin:0 auto;">
  <div style="text-align:center;margin-bottom:56px;">
    <p class="aw-label">{{ section.settings.label | default: "Journal" }}</p>
    <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.5rem,5vw,4rem);color:#2c2420;">{{ blog.title | default: "Our Blog" }}</h1>
    {%- if blog.description != blank -%}
      <p style="font-size:1.05rem;color:#6b5e53;max-width:560px;margin:16px auto 0;line-height:1.8;font-weight:300;">{{ blog.description }}</p>
    {%- endif -%}
  </div>

  {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div class="aw-blog-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="aw-blog-card" style="text-decoration:none;color:inherit;">
          <div class="aw-blog-card__img">
            {%- if article.image != blank -%}
              {{ article.image | image_url: width: 500 | image_tag: loading:'lazy', alt:article.title }}
            {%- else -%}
              <div style="display:flex;align-items:center;justify-content:center;height:100%;background:#ede8e1;color:#c4a882;font-family:'Cormorant Garamond',serif;">Wabi-Sabi</div>
            {%- endif -%}
          </div>
          <div class="aw-blog-card__body">
            <p class="aw-blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</p>
            <h3 class="aw-blog-card__title">{{ article.title }}</h3>
            {%- if article.excerpt != blank -%}
              <p class="aw-blog-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="aw-pagination" style="grid-column:1/-1;">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Main Blog",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 18,
      "step": 3,
      "default": 9,
      "label": "Posts per page"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Journal"
    }
  ]
}
{% endschema %}
