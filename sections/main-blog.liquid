<style>
.aw-blog{padding:64px 40px;background:#FAFAF7}
.aw-blog__inner{max-width:900px;margin:0 auto}
.aw-blog h1{font-family:var(--aw-font-heading);font-size:2rem;font-weight:500;color:#1F1B16;text-align:center;margin:0 0 40px}
.aw-blog__grid{display:flex;flex-direction:column;gap:32px}
.aw-blog__card{display:grid;grid-template-columns:200px 1fr;gap:24px;padding:24px;background:#fff;border-radius:12px;text-decoration:none;transition:all .3s}
.aw-blog__card:hover{transform:translateY(-2px)}
.aw-blog__card-img{border-radius:8px;overflow:hidden;aspect-ratio:4/3;background:#F2EFE8}
.aw-blog__card-img img{width:100%;height:100%;object-fit:cover}
.aw-blog__card-info{display:flex;flex-direction:column;justify-content:center}
.aw-blog__card-date{font-size:.75rem;text-transform:uppercase;letter-spacing:1px;color:#7A8471;margin-bottom:4px}
.aw-blog__card-title{font-family:var(--aw-font-heading);font-size:1.25rem;color:#1F1B16;margin:0 0 8px}
.aw-blog__card-excerpt{font-size:.88rem;color:#5C5648;font-weight:300;line-height:1.6}
@media(max-width:768px){.aw-blog{padding:48px 24px}.aw-blog__card{grid-template-columns:1fr;gap:16px}}
</style>

<section class="aw-blog">
  <div class="aw-blog__inner">
    <h1>{{ blog.title | default: 'Journal' }}</h1>
    <div class="aw-blog__grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="aw-blog__card">
          <div class="aw-blog__card-img">
            {%- if article.image -%}
              {{ article.image | image_url: width: 300 | image_tag: alt: article.title, widths: '150,300,600', loading: 'lazy' }}
            {%- endif -%}
          </div>
          <div class="aw-blog__card-info">
            <span class="aw-blog__card-date">{{ article.published_at | date: '%B %d, %Y' }}</span>
            <h2 class="aw-blog__card-title">{{ article.title }}</h2>
            {%- if article.excerpt.size > 0 -%}
              <p class="aw-blog__card-excerpt">{{ article.excerpt | strip_html | truncatewords: 30 }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Listing",
  "class": "section-blog",
  "presets": [{"name": "Blog Listing", "category": "Blog"}]
}
{% endschema %}
