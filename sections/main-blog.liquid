<style>
  .aw-blog { padding: var(--space-2xl) 0 var(--space-3xl); background: var(--aw-cream); }
  .aw-blog__grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 32px; max-width: 1100px; margin:0 auto; padding:0 40px; }

  .aw-blog-card { display:block;border-radius:var(--radius-lg);overflow:hidden;background:white;border:1px solid rgba(139,115,85,0.06);transition:transform var(--transition-base),box-shadow var(--transition-base); }
  .aw-blog-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);}
  .aw-blog-card__image{aspect-ratio:16/10;overflow:hidden;background:var(--aw-linen);}
  .aw-blog-card__image img{width:100%;height:100%;object-fit:cover;transition:transform var(--transition-slow);}
  .aw-blog-card:hover .aw-blog-card__image img{transform:scale(1.04);}
  .aw-blog-card__body{padding:20px 24px;}
  .aw-blog-card__date{font-size:0.72rem;color:var(--aw-accent);text-transform:uppercase;letter-spacing:1.5px;font-weight:600;margin-bottom:8px;display:block;}
  .aw-blog-card__title{font-family:'Cormorant Garamond',serif;font-size:1.25rem;color:var(--aw-dark);line-height:1.3;margin-bottom:10px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .aw-blog-card__excerpt{font-size:0.9rem;color:var(--aw-stone);line-height:1.65;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;}

  @media(max-width:900px){.aw-blog__grid{grid-template-columns:repeat(2,1fr);gap:24px;padding:0 20px;}}
  @media(max-width:550px){.aw-blog__grid{grid-template-columns:1fr;}}
</style>

<section class="aw-blog">
  <div class="page-width" style="text-align:center;">
    <span class="section-label">Journal</span>
    <h2 class="section-title">{{ blog.title | default: 'Our Blog' }}</h2>
  </div>

  <div class="aw-blog__grid">
    {% for article in blog.articles limit: section.settings.posts_per_page | default: 9 %}
      <a href="{{ article.url }}" class="aw-blog-card">
        <div class="aw-blog-card__image">
          {% if article.image %}
            {{ article.image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              alt: article.title
            }}
          {% else %}
            <div style="width:100%;height:100%;background:linear-gradient(135deg,#d4c5b2,#f5f0e8);display:flex;align-items:center;justify-content:center;color:white;font-family:'Cormorant Garamond',serif;font-size:1.2rem;">{{ article.title | truncate: 30 }}</div>
          {% endif %}
        </div>
        <div class="aw-blog-card__body">
          <time class="aw-blog-card__date">{{ article.published_at | date: '%B %d, %Y' }}</time>
          <h3 class="aw-blog-card__title">{{ article.title }}</h3>
          {% if article.excerpt != blank %}
            <p class="aw-blog-card__excerpt">{{ article.excerpt | strip_html }}</p>
          {% else %}
            <p class="aw-blog-card__excerpt">{{ article.content | strip_html | truncatewords: 25 }}</p>
          {% endif %}
        </div>
      </a>
    {% else %}
      {% for i in (1..6) %}
        <div class="aw-blog-card" style="pointer-events:none;">
          <div class="aw-blog-card__image"></div>
          <div class="aw-blog-card__body"><span class="aw-blog-card__date">Coming Soon</span><h3 class="aw-blog-card__title">Article {{ i }}</h3></div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  {% if paginate.pages > 1 %}
    <nav class="pagination" aria-label="Pagination" style="margin-top:var(--space-2xl);">
      <ol class="pagination-list">
        {% if paginate.previous %}<li><a href="{{ paginate.previous.url }}">&larr;</a></li>{% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}<li><a href="{{ part.url }}">{{ part.title }}</a></li>
          {% else %}<li><span class="{% if part.current %}active{% endif %}">{{ part.title }}</span></li>{% endif %}
        {% endfor %}
        {% if paginate.next %}<li><a href="{{ paginate.next.url }}">&rarr;</a></li>{% endif %}
      </ol>
    </nav>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main Blog",
  "tag": "section",
  "settings": [
    {"type":"range","id":"posts_per_page","min":3,"max":12,"step":3,"default":9,"label":"Posts per page"}
  ]
}
{% endschema %}
