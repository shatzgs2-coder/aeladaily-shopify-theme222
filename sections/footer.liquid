<style>
  .aw-footer {
    background: #2c2420;
    color: rgba(255,255,255,0.6);
    padding: 60px 40px 30px;
  }
  .aw-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 48px;
    max-width: 1280px;
    margin: 0 auto;
  }
  .aw-footer__brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    color: #fff;
    margin-bottom: 12px;
  }
  .aw-footer p,
  .aw-footer a {
    font-size: 0.85rem;
    line-height: 1.8;
    text-decoration: none;
    color: inherit;
    transition: color 0.3s;
  }
  .aw-footer a:hover { color: #d4c4b0; }
  .aw-footer h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #fff;
    margin-bottom: 16px;
    font-weight: 500;
  }
  .aw-footer__newsletter {
    margin-top: 16px;
  }
  .aw-footer__newsletter form {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .aw-footer__newsletter input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 4px;
    background: rgba(255,255,255,0.06);
    color: #fff;
    font-size: 0.85rem;
  }
  .aw-footer__newsletter input::placeholder { color: rgba(255,255,255,0.35); }
  .aw-footer__newsletter button {
    padding: 10px 20px;
    background: #8b7355;
    color: #fff;
    border: none;
    border-radius: 50px;
    font-size: 0.82rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: background 0.3s;
  }
  .aw-footer__newsletter button:hover { background: #a08668; }

  .aw-footer__social {
    display: flex;
    gap: 14px;
    margin-top: 18px;
  }
  .aw-footer__social a {
    width: 36px; height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    font-size: 0.85rem;
    transition: all 0.3s;
  }
  .aw-footer__social a:hover {
    background: rgba(255,255,255,0.08);
    color: #fff;
    border-color: transparent;
  }

  .aw-footer__bottom {
    max-width: 1280px;
    margin: 40px auto 0;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 0.78rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .aw-footer { padding: 40px 20px 20px; }
    .aw-footer__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
</style>

<footer class="aw-footer" id="footer">
  <div class="aw-footer__grid">

    <!-- Brand -->
    <div>
      <div class="aw-footer__brand">{{ shop.name }}</div>
      <p>{{ section.settings.brand_text | default: "Handcrafted home decor inspired by wabi-sabi philosophy. The beauty of imperfection, delivered to your doorstep." }}</p>
      <div class="aw-footer__social">
        <a href="#" aria-label="Instagram">IG</a>
        <a href="#" aria-label="Pinterest">PT</a>
        <a href="#" aria-label="Facebook">FB</a>
      </div>
    </div>

    <!-- Shop Links -->
    <div>
      <h4>{{ section.settings.shop_title | default: "Shop" }}</h4>
      <p><a href="/collections/all">All Products</a></p>
      <p><a href="/collections">Collections</a></p>
      <p><a href="/search">Search</a></p>
    </div>

    <!-- Company Links -->
    <div>
      <h4>{{ section.settings.company_title | default: "Company" }}</h4>
      <p><a href="/pages/about">Our Story</a></p>
      <p><a href="/pages/about">About Us</a></p>
      <p><a href="/pages/contact">Contact</a></p>
    </div>

    <!-- Newsletter / Contact -->
    <div>
      <h4>{{ section.settings.newsletter_title | default: "Stay Connected" }}</h4>
      <p style="font-size: 0.82rem;">{{ section.settings.newsletter_text | default: "Subscribe for new arrivals and wabi-sabi inspiration." }}</p>
      {% form 'customer', id: 'aw-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="aw-footer__newsletter">
          <input type="email" name="contact[email]" placeholder="Your email" required aria-label="Email">
          <button type="submit">Join</button>
        </div>
      {% endform %}
      <p style="margin-top: 14px;">{{ shop.address.city }}, Germany</p>
      <p>Ships across Europe</p>
    </div>

  </div>

  <div class="aw-footer__bottom">
    &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. — Inspired by wabi-sabi.
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Description"
    },
    {
      "type": "text",
      "id": "shop_title",
      "label": "Shop Heading",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "company_title",
      "label": "Company Heading",
      "default": "Company"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Heading",
      "default": "Stay Connected"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter Description"
    }
  ]
}
{% endschema %}
