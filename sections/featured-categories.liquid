<style>
.aw-cats{padding:64px 40px;background:#FAFAF7}
.aw-cats__inner{max-width:1280px;margin:0 auto}
.aw-cats__heading{font-family:var(--aw-font-heading);font-size:2rem;font-weight:500;color:#1F1B16;text-align:center;margin:0 0 40px}
.aw-cats__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},1fr);gap:24px}
.aw-cats__card{position:relative;border-radius:12px;overflow:hidden;background:#fff;transition:transform .3s;text-decoration:none;display:block}
.aw-cats__card:hover{transform:translateY(-4px)}
.aw-cats__card-img{aspect-ratio:1/1;background:#E8E4DD;display:flex;align-items:center;justify-content:center;font-size:3rem;color:#B89484}
.aw-cats__card-img img{width:100%;height:100%;object-fit:cover}
.aw-cats__card-body{padding:20px;text-align:center}
.aw-cats__card-body h3{font-family:var(--aw-font-heading);font-size:1.1rem;color:#1F1B16;margin:0 0 6px}
.aw-cats__card-body p{font-size:.85rem;color:#5C5648;margin:0;font-weight:300}
@media(max-width:768px){.aw-cats{padding:48px 24px}.aw-cats__grid{grid-template-columns:repeat(2,1fr);gap:16px}}
</style>

<section class="aw-cats">
  <div class="aw-cats__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="aw-cats__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="aw-cats__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="aw-cats__card" {{ block.shopify_attributes }}>
          <div class="aw-cats__card-img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: alt: block.settings.title, widths: '200,400,600' }}
            {%- else -%}
              {{ block.settings.icon | default: '&#9670;' }}
            {%- endif -%}
          </div>
          <div class="aw-cats__card-body">
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p>{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "class": "section-featured-categories",
  "settings": [
    {"type": "text","id": "heading","label": "Heading","default": "Shop by Category"},
    {"type": "range","id": "columns_desktop","label": "Desktop columns","min":2,"max":4,"step":1,"default":3}
  ],
  "blocks": [{
    "type": "category","name": "Category","settings": [
      {"type": "text","id": "title","label": "Title","default": "Category Name"},
      {"type": "textarea","id": "description","label": "Description","default": "Category description"},
      {"type": "url","id": "link","label": "Link","default": "/collections/all"},
      {"type": "image_picker","id": "image","label": "Image"},
      {"type": "text","id": "icon","label": "Fallback icon (emoji)","default": "*","info": "Shown when no image is set"}
    ]
  }],
  "presets": [{"name": "Featured Categories", "category": "Collection","blocks":[
    {"type":"category","settings":{"title":"Table Runners","description":"Hand-knotted natural fibers","link":"/collections/all","icon":"*"}},
    {"type":"category","settings":{"title":"Baskets & Storage","description":"Cotton rope artisan craft","link":"/collections/all","icon":"*"}},
    {"type":"category","settings":{"title":"Cushions & Textiles","description":"Soft textures in earthy tones","link":"/collections/all","icon":"*"}}
  ]}]
}
{% endschema %}
