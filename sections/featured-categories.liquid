<style>
  .aw-categories { padding: 100px 40px; background: #fff; }
  .aw-categories__inner { max-width: 1280px; margin: 0 auto; }
  .aw-categories__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .aw-categories__card { position:relative;border-radius:12px;overflow:hidden;aspect-ratio:3/4;cursor:pointer; }
  .aw-categories__card-img { width:100%;height:100%;object-fit:cover;transition:transform .6s ease; }
  .aw-categories__card:hover .aw-categories__card-img { transform:scale(1.06); }
  .aw-categories__card-overlay { position:absolute;inset:0;background:linear-gradient(to top,rgba(44,36,32,.7) 0%,transparent 60%);display:flex;align-items:flex-end;padding:28px;transition:background .3s; }
  .aw-categories__card:hover .aw-categories__card-overlay { background:linear-gradient(to top,rgba(44,36,32,.82) 0%,transparent 65%); }
  .aw-categories__card-title { font-family:'Cormorant Garamond',serif;font-size:1.4rem;color:#fff;font-weight:600; }
  @media(max-width:768px){ .aw-categories{padding:60px 20px} .aw-categories__grid{grid-template-columns:repeat(2,1fr);gap:16px} }
</style>

<section class="aw-categories">
  <div class="aw-categories__inner">
    <p class="aw-label">{{ section.settings.label | default: "Shop by Category" }}</p>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,4vw,3.2rem);color:#2c2420;margin-bottom:48px;">{{ section.settings.title | default: "Curated Categories" }}</h2>
    <div class="aw-categories__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url }}" class="aw-categories__card">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'aw-categories__card-img' }}
          {%- elsif block.settings.collection.featured_image != blank -%}
            {{ block.settings.collection.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title, class: 'aw-categories__card-img' }}
          {%- else -%}
            <div class="aw-categories__card-img" style="display:flex;align-items:center;justify-content:center;background:#ede8e1;">
              <span style="font-family:'Cormorant Garamond',serif;color:#c4a882;font-size:1.5rem;">{{ block.settings.title }}</span>
            </div>
          {%- endif -%}
          <div class="aw-categories__card-overlay"><h3 class="aw-categories__card-title">{{ block.settings.title }}</h3></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category Name"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "category": "Collection",
      "blocks": [
        { "type": "category", "settings": { "title": "Vases & Ceramics" } },
        { "type": "category", "settings": { "title": "Textiles & Linen" } },
        { "type": "category", "settings": { "title": "Candles & Scents" } }
      ]
    }
  ]
}
{% endschema %}
