<style>
  .aw-categories{padding:var(--spacing-xl) 40px;background:#fff}
  .aw-categories__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:48px}
  .aw-categories__card{position:relative;border-radius:var(--radius-md);overflow:hidden;aspect-ratio:3/4}
  .aw-categories__card-img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease-out)}
  .aw-categories__card:hover .aw-categories__card-img{transform:scale(1.06)}
  .aw-categories__card-overlay{
    position:absolute;inset:0;
    background:linear-gradient(to top,rgba(44,36,32,.72) 0%,transparent 60%);
    display:flex;align-items:flex-end;padding:28px;transition:background .35s
  }
  .aw-categories__card:hover .aw-categories__card-overlay{background:linear-gradient(to top,rgba(44,36,32,.84) 0%,transparent 65%)}
  .aw-categories__card-title{font-family:var(--font-heading);font-size:1.4rem;color:#fff;font-weight:600}
  @media(max-width:768px){.aw-categories{padding:var(--spacing-lg)20px}.aw-categories__grid{grid-template-columns:repeat(2,1fr);gap:16px}}
</style>

<section class="aw-categories aw-fade-up">
  <div class="aw-container">
    <p class="aw-label">{{ section.settings.label | default: 'Shop by Category' }}</p>
    <h2>{{ section.settings.title | default: 'Curated Collections' }}</h2>

    <div class="aw-categories__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="aw-categories__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag:
              loading:'lazy', alt:block.settings.title,
              class:'aw-categories__card-img',
              widths:'300,400,500'
            }}
          {%- else -%}
            <!-- Fallback gradient background -->
            <div style="width:100%;height:100%;background:linear-gradient(135deg,#d4c4b0,#8b7355);display:flex;align-items:center;justify-content:center">
              <span style="font-family:var(--font-heading);color:#fff;font-size:1.5rem;font-weight:600">{{ block.settings.title }}</span>
            </div>
          {%- endif -%}
          <div class="aw-categories__card-overlay">
            <h3 class="aw-categories__card-title">{{ block.settings.title }}</h3>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "tag": "section",
  "class": "aw-categories-section",
  "settings": [
    { "type":"text","id":"label","label":"Section Label","default":"Shop by Category" },
    { "type":"text","id":"title","label":"Heading","default":"Our Collections" }
  ],
  "blocks": [
    {
      "type":"category",
      "name":"Category Card",
      "settings": [
        { "type":"text","id":"title","label":"Title","default":"Vases & Ceramics" },
        { "type":"image_picker","id":"image","label":"Card Image" },
        { "type":"url","id":"link","label":"Link to Collection" }
      ]
    }
  ],
  "presets":[
    {
      "name":"Featured Categories",
      "category":"Collection",
      "blocks":[
        {"type":"category","settings":{"title":"Vases & Ceramics"}},
        {"type":"category","settings":{"title":"Textiles & Linen"}},
        {"type":"category","settings":{"title":"Candles & Scents"}}
      ]
    }
  ]
}
{% endschema %}
