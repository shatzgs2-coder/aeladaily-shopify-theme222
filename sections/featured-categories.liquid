<style>
  .aw-categories { padding: var(--space-3xl) 0; background: white; }
  .aw-categories__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), 1fr);
    gap: var(--space-xl);
    max-width: 1100px;
    margin: 0 auto;
  }
  .aw-category-card {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(139,115,85,0.08);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    background: white;
  }
  .aw-category-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .aw-category-card__image { aspect-ratio: 4/3; overflow: hidden; }
  .aw-category-card__image img {
    width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow);
  }
  .aw-category-card:hover .aw-category-card__image img { transform: scale(1.04); }
  .aw-category-card__info {
    padding: var(--space-md) var(--space-lg);
    display: flex; justify-content: space-between; align-items: center;
  }
  .aw-category-card__info h3 {
    font-family: var(--font-body); font-size: var(--font-size-base); font-weight: 600; color: var(--aw-dark);
  }
  .aw-category-arrow { color: var(--aw-accent); font-weight: 700; font-size: 1.2rem; }

  @media (max-width: 768px) {
    .aw-categories__grid { --columns: 2 !important; gap: var(--space-lg); }
  }
</style>

<section class="aw-categories">
  <div class="page-width">
    <span class="section-label">{{ section.settings.label | default: 'Explore' }}</span>
    <h2 class="section-title">{{ section.settings.title | default: 'Shop by Category' }}</h2>

    <div class="aw-categories__grid" style="--columns: {{ section.settings.columns | default: 3 }}">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="aw-category-card">
          <div class="aw-category-card__image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                widths: '400,600',
                alt: block.settings.title
              }}
            {% else %}
              <div style="width:100%;height:100%;background:var(--aw-linen);display:flex;align-items:center;justify-content:center;color:var(--aw-wheat);font-family:'Cormorant Garamond',serif;font-size:1.5rem;">{{ block.settings.title }}</div>
            {% endif %}
          </div>
          <div class="aw-category-card__info">
            <h3>{{ block.settings.title }}</h3>
            <span class="aw-category-arrow">&rarr;</span>
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.show_view_all %}
      <div style="text-align:center;margin-top:var(--space-2xl);">
        <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="view-all-link">View All &rarr;</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "class": "categories-section",
  "tag": "section",
  "settings": [
    {"type":"text","id":"label","default":"Explore","label":"Label"},
    {"type":"text","id":"title","default":"Shop by Category","label":"Heading"},
    {"type":"range","id":"columns","min":2,"max":4,"step":1,"default":3,"label":"Columns"},
    {"type":"checkbox","id":"show_view_all","default":true,"label":"Show View All link"},
    {"type":"url","id":"view_all_link","label":"View All link"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Home Decor"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ]
}
{% endschema %}
