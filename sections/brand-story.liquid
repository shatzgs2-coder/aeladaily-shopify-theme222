<style>
  .aw-brand-story { padding: var(--space-3xl) 0; background: var(--aw-linen); }
  .aw-brand-story__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }
  .aw-brand-story--image-right .aw-brand-story__inner { direction: rtl; }
  .aw-brand-story--image-right > * { direction: ltr; }
  .aw-brand-story__media img {
    border-radius: var(--radius-lg);
    width: 100%; aspect-ratio: 4/5; object-fit: cover;
  }
  .aw-brand-story__label {
    font-size: 0.7rem; color: var(--aw-accent);
    text-transform: uppercase; letter-spacing: 3px; font-weight: 600;
    display: block; margin-bottom: var(--space-sm);
  }
  .aw-brand-story__content h2 { font-family: var(--font-heading); margin-bottom: var(--space-lg); color: var(--aw-dark); }
  .aw-brand-story__content p { color: var(--aw-stone); line-height: 1.85; }

  @media (max-width: 768px) {
    .aw-brand-story__inner { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>

<section class="aw-brand-story aw-brand-story--{{ section.settings.image_alignment | default: 'image-left' }}">
  <div class="aw-brand-story__inner">
    {% if section.settings.image != blank %}
      <div class="aw-brand-story__media">
        {{ section.settings.image | image_url: width: 800 | image_tag:
          loading: 'lazy',
          widths: '500,800',
          alt: section.settings.title
        }}
      </div>
    {% endif %}
    <div class="aw-brand-story__content">
      <span class="aw-brand-story__label">{{ section.settings.label | default: 'Our Story' }}</span>
      <h2>{{ section.settings.title | default: 'The Beauty of Imperfection' }}</h2>
      {{ section.settings.text | default: '<p>Each piece in our collection is thoughtfully crafted to celebrate the natural imperfections that make life beautiful. We believe in slow living, mindful consumption, and the quiet elegance of wabi-sabi.</p>' }}
      {% if section.settings.button_label %}
        <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="btn btn--primary" style="margin-top:var(--space-xl);">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "class": "brand-story-section",
  "settings": [
    {"type":"text","id":"label","default":"Our Philosophy","label":"Label"},
    {"type":"text","id":"title","default":"The Beauty of Imperfection","label":"Heading"},
    {"type":"richtext","id":"text","label":"Text"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"select","id":"image_alignment","options":[{"value":"image-left","label":"Image left"},{"value":"image-right","label":"Image right"}],"default":"image-left","label":"Image alignment"},
    {"type":"text","id":"button_label","label":"Button label"},
    {"type":"url","id":"button_link","label":"Button link"}
  ]
}
{% endschema %}
