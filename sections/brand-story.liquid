<style>
  .aw-brand-story{padding:var(--spacing-xl) 40px;background:var(--aw-cream)}
  .aw-brand-story__inner{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  .aw-brand-story__img{border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-medium);aspect-ratio:4/5}
  .aw-brand-story__img img{width:100%;height:100%;object-fit:cover}
  .aw-brand-story__content{padding:12px 0}
  .aw-brand-story__title{font-size:clamp(2rem,3.5vw,2.8rem);margin-bottom:24px;line-height:1.2}
  .aw-brand-story__text{font-size:1rem;color:#6b5e53;line-height:1.85;margin-bottom:36px;font-weight:300}
  .aw-brand-story__values{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .aw-brand-story__value{
    padding:22px;background:#fff;border-radius:var(--radius-sm);
    border-left:3px solid var(--aw-terracotta);transition:transform .3s var(--ease-out);
  }
  .aw-brand-story__value:hover{transform:translateX(6px)}
  .aw-brand-story__value strong{display:block;font-family:var(--font-heading);font-size:1rem;color:var(--aw-charcoal);margin-bottom:4px}
  .aw-brand-story__value p{font-size:.88rem;color:var(--aw-stone);margin:0;line-height:1.55}

  @media(max-width:768px){
    .aw-brand-story{padding:var(--spacing-lg)20px}.aw-brand-story__inner{grid-template-columns:1fr;gap:36px}
    .aw-brand-story__values{grid-template-columns:1fr}
  }
</style>

<section class="aw-brand-story aw-fade-up">
  <div class="aw-brand-story__inner">
    <!-- Image -->
    <div class="aw-brand-story__img" {{ block.shopify_attributes }}>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag:
          loading:'lazy', alt:'Brand Story',
          widths:'400,600,800',
          style:'width:100%;height:100%;object-fit:cover'
        }}
      {%- else -%}
        <!-- Fallback warm gradient placeholder -->
        <div style="width:100%;height:100%;background:linear-gradient(160deg,#ede8e1 0%,#d4c4b0 50%,#c17f59 100%);
        display:flex;align-items:center;justify-content:center">
          <span style="font-family:var(--font-heading);font-size:3rem;color:#faf7f2;font-weight:600">AW</span>
        </div>
      {%- endif -%}
    </div>

    <!-- Content -->
    <div class="aw-brand-story__content">
      <p class="aw-label">{{ section.settings.label | default: 'Our Story' }}</p>
      <h2 class="aw-brand-story__title">{{ section.settings.heading }}</h2>
      <div class="aw-brand-story__text">{{ section.settings.text }}</div>

      {%- if section.blocks.size > 0 -%}
      <div class="aw-brand-story__values">
        {%- for block in section.blocks -%}
          <div class="aw-brand-story__value aw-fade-up" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            <p>{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "class": "aw-brand-story-section",
  "settings": [
    { "type":"text","id":"label","label":"Label","default":"Our Story" },
    { "type":"text","id":"heading","label":"Heading","default":"The Beauty of Imperfection" },
    {
      "type":"richtext","id":"text","label":"Story Text",
      "default":"<p>Atelier Wabi was born in Berlin, inspired by the Japanese philosophy of wabi-sabi — finding beauty in imperfection, transience, and simplicity. Each piece in our collection tells a story of craftsmanship, natural materials, and mindful living.</p>"
    },
    { "type":"image_picker","id":"image","label":"Story Image","info":"Recommended: portrait orientation (4:5)" }
  ],
  "blocks":[
    {"type":"value","name":"Value","settings":[
      {"type":"text","id":"title","label":"Title","default":"Handcrafted"},
      {"type":"textarea","id":"description","label":"Description","default":"Every piece is made by hand using traditional techniques passed down through generations."}
    ]},
    {"type":"value","name":"Value","settings":[
      {"type":"text","id":"title","label":"Title","default":"Natural Materials"},
      {"type":"textarea","id":"description","label":"Description","default:"We source sustainable materials — cotton, linen, clay, wood — that age beautifully over time."}
    ]},
    {"type":"value","name":"Value","settings":[
      {"type":"text","id":"title","label":"Title","default":"Slow Living"},
      {"type":"textarea","id":"description","label":"Description","default:"Our collection invites you to slow down, appreciate the small things, and create a mindful home."}
    ]}
  ],
  "presets":[
    {"name":"Brand Story","category":"Text","blocks":[
      {"type":"value","settings":{"title":"Handcrafted"}},
      {"type":"value","settings":{"title":"Natural Materials"}},
      {"type":"value","settings":{"title":"Slow Living"}}
    ]}
  ]
}
{% endschema %}
