<style>
.aw-story{padding:80px 40px;background:#F2EFE8}
.aw-story__inner{max-width:900px;margin:0 auto;text-align:center}
.aw-story__label{font-size:.75rem;text-transform:uppercase;letter-spacing:3px;color:#7A8471;font-weight:500;margin-bottom:16px;display:block}
.aw-story__heading{font-family:var(--aw-font-heading);font-size:2.4rem;font-weight:500;color:#1F1B16;margin:0 0 24px}
.aw-story__text{font-size:1.02rem;color:#5C5648;line-height:1.9;font-weight:300;max-width:680px;margin:0 auto 48px}
.aw-story__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;text-align:center}
.aw-story__card{padding:36px 24px;background:#fff;border-radius:12px;box-shadow:none}
.aw-story__card h3{font-family:var(--aw-font-heading);font-size:1.15rem;color:#1F1B16;margin:0 0 10px}
.aw-story__card p{font-size:.88rem;color:#5C5648;line-height:1.6;font-weight:300}
.aw-story__icon{font-size:2rem;margin-bottom:12px;display:block}
@media(max-width:768px){.aw-story{padding:64px 24px}.aw-story__grid{grid-template-columns:1fr}.aw-story__heading{font-size:1.8rem}}
</style>

<section class="aw-story">
  <div class="aw-story__inner">
    <span class="aw-story__label">{{ section.settings.label }}</span>
    <h2 class="aw-story__heading">{{ section.settings.heading }}</h2>
    <p class="aw-story__text">{{ section.settings.description }}</p>

    <div class="aw-story__grid">
      {%- for block in section.blocks -%}
        <div class="aw-story__card" {{ block.shopify_attributes }}>
          <span class="aw-story__icon">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "class": "section-brand-story",
  "settings": [
    {"type": "text","id": "label","label": "Label","default": "Our Philosophy"},
    {"type": "text","id": "heading","label": "Heading","default": "The Art of Imperfect Beauty"},
    {"type": "textarea","id": "description","label": "Description","default": "Rooted in the Japanese philosophy of wabi-sabi, we celebrate the beauty of natural materials, handmade craftsmanship, and the quiet elegance of simple, mindful living."}
  ],
  "blocks": [{
    "type": "value","name": "Value Card","settings": [
      {"type": "text","id": "icon","label": "Icon (emoji)","default":"*"},
      {"type": "text","id": "title","label": "Title","default": "Artisan Crafted"},
      {"type": "textarea","id": "text","label": "Description","default": "Every piece is made by hand using traditional techniques passed down through generations."}
    ]
  }],
  "presets": [{"name": "Brand Story", "category": "Text","blocks":[
    {"type":"value","settings":{"icon":"*","title":"Artisan Crafted","text":"Every piece is made by hand using traditional techniques passed down through generations."}},
    {"type":"value","settings":{"icon":"*","title":"Natural Materials","text":"We source sustainable materials that age beautifully over time."}},
    {"type":"value","settings":{"icon":"*","title":"Wabi-Sabi Philosophy","text":"Slow down, appreciate imperfect beauty, create a mindful home."}}
  ]}]
}
{% endschema %}
