<style>
  .aw-story { padding:100px 40px;background:#fff; }
  .aw-story__inner { max-width:1280px;margin:0 auto; }
  .aw-story__grid { display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center; }
  .aw-story__image img { border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.1);width:100%; }
  .aw-story__title { font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,4vw,3.2rem);color:#2c2420;margin-bottom:24px;line-height:1.2; }
  .aw-story__text p { margin-bottom:20px;color:#6b5e53;font-weight:300;line-height:1.9;font-size:1rem; }
  .aw-story__values { display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:36px; }
  .aw-story__value { padding:24px;background:#faf7f2;border-radius:12px; }
  .aw-story__value h4 { font-family:'Cormorant Garamond',serif;font-size:1.15rem;color:#8b7355;margin-bottom:8px; }
  .aw-story__value p { font-size:.88rem;margin-bottom:0; }
  @media(max-width:768px){ .aw-story{padding:60px 20px} .aw-story__grid{grid-template-columns:1fr;gap:40px} .aw-story__values{grid-template-columns:1fr} }
</style>

<section class="aw-story" id="story">
  <div class="aw-story__inner">
    <div class="aw-story__grid">
      {%- if section.settings.image != blank -%}
        <div class="aw-story__image">
          {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Brand Story' }}
        </div>
      {%- else -%}
        <div class="aw-story__image">
          <img src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=700&h=900&fit=crop" alt="Wabi-sabi interior" loading="lazy">
        </div>
      {%- endif -%}

      <div>
        <p class="aw-label">{{ section.settings.label | default: "Our Story" }}</p>
        <h2 class="aw-story__title">{{ section.settings.title | default: "Where Less Becomes More" }}</h2>
        <div class="aw-story__text">
          {%- if section.settings.richtext != blank -%}
            {{ section.settings.richtext }}
          {%- else -%}
            <p>Born from a love for Japanese aesthetics and European craftsmanship, our collection celebrates the beauty found in imperfection. Every piece tells a story of hands that shaped it, materials that grew slowly, and designs that honor time rather than chase it.</p>
            <p>We work directly with skilled artisans who weave cotton rope by hand, pour soy wax candles in small batches, and shape ceramics with intention. No two pieces are exactly alike — and that is precisely the point.</p>
          {%- endif -%}
        </div>
        <div class="aw-story__values">
          <div class="aw-story__value"><h4>Handcrafted</h4><p>Made by human hands, not machines. You feel the difference.</p></div>
          <div class="aw-story__value"><h4>Natural Materials</h4><p>Linen, clay, soy wax, solid wood. Pure and biodegradable.</p></div>
          <div class="aw-story__value"><h4>Slow Living</h4><p>Buy less, choose well, make it last a lifetime.</p></div>
          <div class="aw-story__value"><h4>Direct Artisan</h4><p>No middlemen — we connect you with the maker directly.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Our Story" },
    { "type": "text", "id": "title", "label": "Title", "default: "Where Less Becomes More" },
    { "type": "richtext", "id": "richtext", "label": "Story Content" },
    { "type": "image_picker", "id": "image", "label": "Story Image" }
  ],
  "presets": [{ "name": "Brand Story", "category": "Text" }]
}
{% endschema %}
