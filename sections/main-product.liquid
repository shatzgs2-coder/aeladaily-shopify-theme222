<style>
.aw-prod{padding:64px 40px;background:#FAFAF7}
.aw-prod__inner{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
.aw-prod__gallery{position:sticky;top:88px}
.aw-prod__main-img{border-radius:12px;overflow:hidden;aspect-ratio:1/1;background:#F2EFE8;margin-bottom:12px}
.aw-prod__main-img img{width:100%;height:100%;object-fit:cover}
.aw-prod__thumbs{display:flex;gap:10px}
.aw-prod__thumb{width:72px;height:72px;border-radius:8px;overflow:hidden;cursor:pointer;border:2px solid transparent;transition:border-color .2s;background:#F2EFE8}
.aw-prod__thumb.active{border-color:#8B6F47}
.aw-prod__thumb img{width:100%;height:100%;object-fit:cover}
.aw-prod__info{display:flex;flex-direction:column;gap:20px}
.aw-prod__vendor{font-size:.75rem;text-transform:uppercase;letter-spacing:2px;color:#7A8471;font-weight:500}
.aw-prod__title{font-family:var(--aw-font-heading);font-size:2.4rem;font-weight:500;color:#1F1B16;margin:0;line-height:1.2}
.aw-prod__price-wrap{display:flex;align-items:baseline;gap:12px}
.aw-prod__price{font-size:1.4rem;font-weight:500;color:#1F1B16}
.aw-prod__compare{font-size:1rem;text-decoration:line-through;color:#B89484}
.aw-prod__desc{font-size:.95rem;color:#5C5648;line-height:1.8;font-weight:300}
.aw-prod__form{display:flex;flex-direction:column;gap:24px;padding:24px 0;border-top:1px solid #E8E4DD;border-bottom:1px solid #E8E4DD}
.aw-prod__opt-label{font-size:.8rem;text-transform:uppercase;letter-spacing:1.5px;color:#1F1B16;font-weight:500;margin-bottom:10px}
.aw-prod__opts{display:flex;flex-wrap:wrap;gap:10px}
.aw-prod__opt{min-width:44px;height:44px;padding:0 16px;border-radius:4px;border:1.5px solid #E8E4DD;background:#fff;cursor:pointer;font-size:.85rem;color:#1F1B16;text-align:center;transition:all .2s;display:flex;align-items:center;justify-content:center}
.aw-prod__opt:hover{border-color:#8B6F47}
.aw-prod__opt.active{border-color:#8B6F47;background:#F2EFE8;font-weight:500}
.aw-prod__opt--color{width:36px;height:36px;border-radius:50%;padding:0;position:relative}
.aw-prod__opt--color.active::after{content:'';position:absolute;inset:-4px;border-radius:50%;border:2px solid #8B6F47}
.aw-prod__qty{display:flex;align-items:center;gap:12px}
.aw-prod__qty-label{font-size:.8rem;text-transform:uppercase;letter-spacing:1.5px;color:#1F1B16;font-weight:500}
.aw-prod__qty-input{width:64px;height:44px;text-align:center;border:1.5px solid #E8E4DD;border-radius:4px;font-size:.9rem;background:#fff}
.aw-prod__atc{width:100%;padding:16px;font-size:1rem}
.aw-prod__meta{display:flex;flex-direction:column;gap:16px}
.aw-prod__size-guide{padding:20px;background:#F2EFE8;border-radius:12px;margin-top:8px}
.aw-prod__size-guide h4{font-size:.85rem;text-transform:uppercase;letter-spacing:1.5px;color:#1F1B16;margin:0 0 16px}
.aw-prod__size-table{width:100%;border-collapse:collapse;font-size:.85rem}
.aw-prod__size-table th,.aw-prod__size-table td{padding:10px 12px;text-align:left;border-bottom:1px solid #E8E4DD}
.aw-prod__size-table th{font-weight:500;color:#1F1B16;font-size:.78rem;text-transform:uppercase;letter-spacing:1px}
.aw-prod__size-table td{color:#5C5648;font-weight:300}
@media(max-width:968px){.aw-prod__inner{grid-template-columns:1fr;gap:40px}.aw-prod{padding:32px 20px}.aw-prod__title{font-size:1.8rem}.aw-prod__gallery{position:static}}
</style>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="aw-prod" data-section-type="product">
  <div class="aw-prod__inner">
    <!-- Gallery -->
    <div class="aw-prod__gallery">
      <div class="aw-prod__main-img">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.title, id: 'aw-prod-main-img', widths: '400,600,800,1200', loading: 'eager' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="aw-prod__thumbs">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <div class="aw-prod__thumb{% if forloop.first %} active{% endif %}" data-media-id="{{ media.id }}">
                {{ media | image_url: width: 150 | image_tag: alt: product.title, widths: '75,150,300' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info -->
    <div class="aw-prod__info">
      {%- if product.vendor != blank -%}
        <span class="aw-prod__vendor">{{ product.vendor }}</span>
      {%- endif -%}
      <h1 class="aw-prod__title">{{ product.title }}</h1>

      <div class="aw-prod__price-wrap">
        <span class="aw-prod__price" data-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="aw-prod__compare" data-compare-price>{{ current_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <p class="aw-prod__desc">{{ product.description | strip_html | truncatewords: 50 }}</p>
      {%- endif -%}

      <!-- Variant Selector -->
      {%- form 'product', product, class: 'aw-prod__form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-select>
        <input type="hidden" name="quantity" value="1">

        {%- if product.variants.size > 1 -%}
          {%- for option in product.options_with_values -%}
            <div class="aw-prod__variant">
              <p class="aw-prod__opt-label">{{ option.name }}: <span data-option-name>{{ option.selected_value }}</span></p>
              <div class="aw-prod__opts" data-option-index="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  {%- assign opt_class = 'aw-prod__opt' -%}
                  {%- if option.name == 'Color' or option.name == 'Colour' -%}
                    {%- assign opt_class = opt_class | append: ' aw-prod__opt--color' -%}
                    {%- assign bg = value | handle | prepend: 'var(--aw-color-' | append: ')' -%}
                  {%- endif -%}
                  <button type="button"
                    class="{{ opt_class }}{% if option.selected_value == value %} active{% endif %}"
                    data-option-value="{{ value | escape }}"
                    {%- if option.name == 'Color' or option.name == 'Colour' -%}
                      style="background-color:{{ value | downcase | replace: ' ','-' }};color:transparent"
                    {%- endif -%}
                    {%- if option.selected_value == value %}aria-current="true"{% endif -%}
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="aw-prod__qty">
            <span class="aw-prod__qty-label">Qty</span>
            <input type="number" name="quantity" class="aw-prod__qty-input" value="1" min="1" pattern="[0-9]*">
          </div>
        {%- endif -%}

        <button type="submit" name="add" class="aw-btn aw-btn--primary aw-prod__atc"
          {%- unless current_variant.available %}disabled{% endunless -%}
          data-add-to-cart>
          {%- if current_variant.available -%}
            {{ section.settings.atc_text }}
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      {%- endform -%}

      <!-- Size Guide -->
      {%- if section.settings.show_size_guide -%}
        <details class="aw-prod__size-guide">
          <summary style="cursor:pointer;font-weight:500;color:#1F1B16;list-style:none;display:flex;justify-content:space-between;align-items:center">
            <span>Size Guide</span>
            <span style="font-size:.8rem;color:#7A8471">+</span>
          </summary>
          <table class="aw-prod__size-table" style="margin-top:16px">
            <thead><tr><th>Size</th><th>Length (cm)</th><th>Width (cm)</th><th>Height (cm)</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>30</td><td>20</td><td>10</td></tr>
              <tr><td>M</td><td>40</td><td>25</td><td>12</td></tr>
              <tr><td>L</td><td>50</td><td>30</td><td>15</td></tr>
            </tbody>
          </table>
        </details>
      {%- endif -%}

      <!-- Shipping Info -->
      <div class="aw-prod__meta">
        <span style="display:flex;align-items:center;gap:8px;font-size:.85rem;color:#5C5648">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Free shipping on orders over 50 EUR
        </span>
        <span style="display:flex;align-items:center;gap:8px;font-size:.85rem;color:#5C5648">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          Handcrafted in Berlin, Germany
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Detail",
  "class": "section-main-product",
  "settings": [
    {"type": "checkbox","id": "show_size_guide","label": "Show size guide","default": true},
    {"type": "text","id": "atc_text","label": "Add to cart button text","default": "Add to Cart"}
  ],
  "presets": [{"name": "Product Detail", "category": "Product"}]
}
{% endschema %}
