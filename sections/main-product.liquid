{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_img = current_variant.featured_image | default: product.featured_image -%}

<style>
  .aw-pdp{padding:var(--spacing-xl) 40px;background:var(--aw-cream);min-height:70vh}
  .aw-pdp__inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}

  /* Gallery */
  .aw-pdp__gallery{position:sticky;top:100px}
  .aw-pdp__main-img{aspect-ratio:1;background:var(--aw-linen);border-radius:var(--radius-lg);overflow:hidden;margin-bottom:14px;box-shadow:var(--shadow-soft)}
  .aw-pdp__main-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s var(--ease-out)}
  .aw-pdp__main-img:hover img{transform:scale(1.03)}
  .aw-pdp__thumbs{display:flex;gap:10px;flex-wrap:wrap}
  .aw-pdp__thumb{
    width:72px;height:72px;border-radius:8px;overflow:hidden;
    cursor:pointer;border:2px solid transparent;transition:border-color .25s;background:var(--aw-wheat)
  }
  .aw-pdp__thumb:hover,.aw-pdp__thumb.active{border-color:var(--aw-earth)}
  .aw-pdp__thumb img{width:100%;height:100%;object-fit:cover}

  /* Info */
  .aw-pdp__info{padding-top:8px}
  .aw-pdp__type{font-size:.7rem;color:var(--aw-terracotta);text-transform:uppercase;letter-spacing:2.5px;margin-bottom:10px;font-weight:500}
  .aw-pdp__title{font-family:var(--font-heading);font-size:clamp(2rem,4vw,3rem);color:var(--aw-charcoal);line-height:1.15;margin-bottom:16px}
  .aw-pdp__price{font-family:var(--font-heading);font-size:2rem;color:var(--aw-earth);font-weight:600;margin-bottom:24px}

  /* Variant Swatches */
  .aw-variant-group{margin-bottom:24px}
  .aw-variant-group label{display:block;font-size:.8rem;text-transform:uppercase;letter-spacing:1.5px;color:var(--aw-charcoal);margin-bottom:10px;font-weight:500}
  .swatch-group{display:flex;gap:8px;flex-wrap:wrap}
  .aw-swatch{
    padding:9px 20px;border:1.5px solid #d4cec4;background:transparent;
    border-radius:4px;font-size:.88rem;color:var(--aw-charcoal);cursor:pointer;
    transition:all .25s var(--ease-out);min-width:44px;text-align:center
  }
  .aw-swatch:hover{border-color:var(--aw-earth);color:var(--aw-earth)}
  .aw-swatch.selected{background:var(--aw-earth);color:#fff;border-color:var(--aw-earth)}

  /* Size Guide (Always visible) */
  .aw-size-guide{margin:28px 0;border:1px solid var(--aw-linen);border-radius:var(--radius-sm);overflow:hidden}
  .aw-size-guide summary{
    padding:16px 22px;background:var(--aw-wheat);cursor:pointer;font-weight:500;
    list-style:none;display:flex;justify-content:space-between;align-items:center
  }
  .aw-size-guide summary::-webkit-details-marker{display:none}
  .aw-size-guide table{width:100%;border-collapse:collapse}
  .aw-size-guide th,.aw-size-guide td{padding:13px 22px;text-align:left;border-top:1px solid var(--aw-linen);font-size:.9rem}
  .aw-size-guide th{background:var(--aw-cream);font-weight:600;color:var(--aw-charcoal)}

  /* Features List */
  .aw-pdp__features{list-style:none;padding:0;margin:28px 0 0}
  .aw-pdp__features li{display:flex;align-items:center;gap:10px;font-size:.9rem;color:var(--aw-stone);padding:6px 0}
  .aw-pdp__features li::before{content:'✦';color:var(--aw-terracotta);font-size:.7rem}

  @media(max-width:768px){.aw-pdp{padding:var(--spacing-lg)20px}.aw-pdp__inner{grid-template-columns:1fr;gap:36px}.aw-pdp__gallery{position:static}}
</style>

<section class="aw-pdp">
  <div class="aw-pdp__inner">

    <!-- ===== GALLERY ===== -->
    <div class="aw-pdp__gallery" data-product-gallery>
      <!-- Main Image -->
      <div class="aw-pdp__main-img">
        {%- if featured_img -%}
          {{ featured_img | image_url: width: 800 | image_tag:
            id:'pdp-main-img', loading:'eager',
            alt:product.title,
            widths:'400,600,800',
            style:'width:100%;height:100%;object-fit:cover'
          }}
        {%- else -%}
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#ede8e1,#d4c4b0)">
            <span style="font-family:var(--font-heading);color:var(--aw-clay);font-size:2rem">Atelier Wabi</span>
          </div>
        {%- endif -%}
      </div>

      <!-- Thumbnails -->
      {%- if product.images.size > 1 -%}
      <div class="aw-pdp__thumbs">
        {%- for image in product.images limit:6 -%}
          <button class="aw-pdp__thumb{% if forloop.first %} active{% endif %}"
            onclick="document.getElementById('pdp-main-img').src='{{ image | image_url: width: 800 }}';
              this.closest('.aw-pdp__thumbs').querySelectorAll('.aw-pdp__thumb').forEach(function(t){t.classList.remove('active')});
              this.classList.add('active')"
            type="button"
            aria-label="View image {{ forloop.index }}"
          >
            {{ image | image_url: width: 150 | image_tag:
              alt:product.title | append: ' - Image ' | append: forloop.index,
              loading:'lazy',
              style:'width:100%;height:100%;object-fit:cover'
            }}
          </button>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>

    <!-- ===== PRODUCT INFO ===== -->
    <div class="aw-pdp__info">

      <p class="aw-pdp__type">{{ product.type | default: 'Home Decor' }}</p>
      <h1 class="aw-pdp__title">{{ product.title }}</h1>

      <div class="aw-price-display aw-pdp__price">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <del style="font-size:1.1rem;color:var(--aw-stone);margin-right:8px">{{ current_variant.compare_at_price | money }}</del>
        {%- endif -%}
        {{ current_variant.price | money }}
      </div>

      <div style="height:1px;background:linear-gradient(to right,var(--aw-linen),transparent);margin:24px 0"></div>

      <!-- Description -->
      {%- if product.description != blank -%}
        <div class="aw-pdp__desc" style="font-size:.98rem;color:#6b5e53;line-height:1.85;margin-bottom:32px">{{ product.description }}</div>
      {%- else -%}
        <p style="font-size:.98rem;color:#6b5e53;line-height:1.85;margin-bottom:32px">
          Handcrafted piece from our Atelier Wabi collection. Made with natural materials and designed to bring warmth to your living space.
        </p>
      {%- endif -%}

      {% form 'product', product, class:'aw-product-form', id:'pdp-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        <!-- Variant Selectors -->
        {%- for option in product.options_with_values -%}
          <div class="aw-variant-group" data-option-index="{{ forloop.index0 }}">
            <label>{{ option.name }}</label>
            <div class="swatch-group">
              {%- for value in option.values -%}
                <button type="button"
                  class="aw-swatch{% if option.selected_value == value %} selected{% endif %}"
                  data-value="{{ value }}"
                >{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}

        <!-- Hidden select for Shopify -->
        {%- unless product.has_only_default_variant -%}
          <select name="id" id="ProductSelect-{{ section.id }}" style="position:absolute;left:-9999px;height:1px;width:1px;opacity:0;overflow:hidden" aria-label="Variant selection">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}
                data-available="{{ variant.available }}">
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
        {%- endunless -%}

        <!-- SIZE GUIDE (always visible) -->
        <details class="aw-size-guide aw-details">
          <summary>Size Guide & Details &#9660;</summary>
          <table>
            <thead><tr><th>Size</th><th>Width (cm)</th><th>Height/Length (cm)</th><th>Ideal For</th></tr></thead>
            <tbody>
              <tr><td>S</td><td>30–40</td><td>25–35</td><td>Small spaces / side tables / shelves</td></tr>
              <tr><td>M</td><td>45–60</td><td>38–50</td><td>Dining tables / consoles / mantels</td></tr>
              <tr><td>L</td><td>65+</td><td>55+</td><td>Floor pieces / statement items / focal points</td></tr>
            </tbody>
          </table>
          <div style="padding:18px 22px;background:var(--aw-cream);font-size:.85rem;color:var(--aw-earth);line-height:1.75;border-top:1px solid var(--aw-linen)">
            <strong>Note:</strong> Each piece is handmade, so dimensions may vary slightly.
            This is part of the wabi-sabi charm — no two items are exactly identical.
          </div>
        </details>

        <!-- Quantity -->
        <div style="display:flex;align-items:center;gap:16px;margin-top:24px">
          <quantity-input class="aw-qty">
            <button type="button" class="aw-qty__btn" data-action="minus">&#8722;</button>
            <input type="number" name="quantity" value="1" min="1" max="{{ section.settings.max_quantity }}" class="aw-qty__input">
            <button type="button" class="aw-qty__btn" data-action="plus">+</button>
          </quantity-input>
          <span style="font-size:.85rem;color:var(--aw-stone)">Quantity</span>
        </div>

        <!-- Add to Cart Button -->
        <button type="submit" name="add"
          class="aw-btn aw-btn--primary"
          style="width:100%;margin-top:20px;padding:18px;font-size:.95rem;letter-spacing:1.5px"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {%- if current_variant.available -%}
            Add to Cart
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      {% endform %}

      <!-- Features -->
      {%- if section.settings.show_features -%}
      <div style="height:1px;background:linear-gradient(to right,var(--aw-linen),transparent);margin:36px 0"></div>
      <ul class="aw-pdp__features">
        <li>Handcrafted with natural materials</li>
        <li>Wabi-sabi inspired design — each piece unique</li>
        <li>Free shipping in Germany over €49</li>
        <li>30-day return guarantee</li>
        <li>Carbon-neutral packaging</li>
      </ul>
      {%- endif -%}

    </div><!-- /info -->
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "class": "aw-product-section",
  "settings":[
    {"type":"checkbox","id":"show_features","label":"Show feature list","default":true},
    {"type":"range","id":"max_quantity","label":"Max quantity per order","min":1,"max":99,"default":10}
  ],
  "presets":[{"name":"Product Page"}]
}
{% endschema %}
