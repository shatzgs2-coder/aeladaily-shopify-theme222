{%- assign product = section.settings.product | default: product -%}

<section class="product-section">
  <div class="page-width product-container">
    <!-- Product Gallery -->
    <div class="product-gallery">
      {%- if product.featured_image -%}
        <div class="gallery-main">
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            id="main-product-image"
            width="800"
            height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
          >
        </div>
        {% if product.images.size > 1 %}
          <div class="gallery-thumbs">
            {%- for image in product.images limit: 4 -%}
              <button class="thumb-btn" data-image-url="{{ image | image_url: width: 800 }}">
                <img src="{{ image | image_url: width: 100 }}" alt="" loading="lazy" width="100" height="100">
              </button>
            {%- endfor -%}
          </div>
        {% endif %}
      {%- else -%}
        <div class="gallery-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info -->
    <div class="product-info">
      <!-- Vendor / Breadcrumb -->
      {%- if product.vendor != blank -%}
        <span class="product-vendor">{{ product.vendor }}</span>
      {%- endif -%}

      <!-- Title -->
      <h1 class="product-title">{{ product.title }}</h1>

      <!-- Price -->
      <div class="product-price-wrapper">
        <span class="price--current">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="price--compare">{{ product.compare_at_price | money }}</span>
          <span class="price--save">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
        {%- endif -%}
      </div>

      <!-- Short Description -->
      {%- if product.description != blank -%}
        <div class="product-short-desc">
          {{ product.description | strip_html | truncatewords: 30 }}
        </div>
      {%- endif -%}

      <!-- Color Picker (Variant Option) -->
      {%- if product.has_only_default_variant == false -%}
        {%- for option in product.options_with_values -%}
          {%- if option.name == 'Color' or option.name == 'Colour' -%}
          <div class="product-option" data-option-name="{{ option.name | handleize }}">
            <label>{{ option.name }}: <strong data-selected-value>{{ option.selected_value }}</strong></label>
            <div class="swatch-group">
              {%- for value in option.values -%}
                <button
                  type="button"
                  class="swatch swatch--color{% if value == option.selected_value %} is-active{% endif %}"
                  data-value="{{ value }}"
                  aria-label="{{ value }}"
                  style="--swatch-color: {{ value | handle }}"
                >
                  <span class="swatch__check">&check;</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
          {%- else -%}
          <div class="product-option" data-option-name="{{ option.name | handleize }}">
            <label>{{ option.name }}: <strong data-selected-value>{{ option.selected_value }}</strong></label>
            <div class="size-btns">
              {%- for value in option.values -%}
                <button type="button" class="size-btn{% if value == option.selected_value %} is-active{% endif %}" data-value="{{ value }}">{{ value }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <!-- Size Guide Table -->
      {%- if section.settings.show_size_guide -%}
      <details class="details-modal size-guide-details">
        <summary class="details-summary">Size Guide</summary>
        <div class="details-content">
          <table class="size-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Dimensions</th>
                <th>Weight</th>
                <th>Fill</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>S</td><td>30 × 20 cm</td><td>~180g</td><td>Polyester fiber</td></tr>
              <tr><td>M</td><td>40 × 25 cm</td><td>~300g</td><td>Polyester fiber</td></tr>
              <tr><td>L</td><td>50 × 35 cm</td><td>~500g</td><td>PP cotton</td></tr>
            </tbody>
          </table>
        </div>
      </details>
      {%- endif -%}

      <!-- Quantity & Add to Cart -->
      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="product-form">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-selected-variant>

        <div class="product-actions">
          <quantity-input class="qty-selector">
            <button type="button" class="qty-btn" data-decrease>&minus;</button>
            <input type="number" name="quantity" value="1" min="1" class="qty-input" readonly>
            <button type="button" class="qty-btn" data-increase>&plus;</button>
          </quantity-input>

          <button type="submit" name="add" class="btn btn--primary btn--add-to-cart"{% unless product.available %} disabled{% endunless %}>
            {%- if product.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        </div>
      </form>

      <!-- Product Details Accordion -->
      {%- if section.settings.show_details -%}
      <div class="product-details">
        <details class="details-modal" open>
          <summary class="details-summary">Description</summary>
          <div class="details-content rte">{{ product.description }}</div>
        </details>
        <details class="details-modal">
          <summary class="details-summary">Material & Care</summary>
          <div class="details-content">
            <p>{{ section.settings.material_text | default: "Made from premium natural materials. Spot clean only; air dry flat." }}</p>
          </div>
        </details>
        <details class="details-modal">
          <summary class="details-summary">Shipping & Returns</summary>
          <div class="details-content">
            <p>{{ section.settings.shipping_text | default: "Free shipping on orders over €50. Returns accepted within 14 days of delivery." }}</p>
          </div>
        </details>
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

{{ 'section-main-product.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "class": "product-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "default": true,
      "label": "Show size guide"
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "default": true,
      "label": "Show details accordion"
    },
    {
      "type": "textarea",
      "id": "material_text",
      "default": "Made from premium natural materials. Spot clean only; air dry flat.",
      "Label": "Material text"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "default": "Free shipping on orders over €50. Returns accepted within 14 days of delivery.",
      "label": "Shipping text"
    }
  ],
  "presets": [
    {
      "name": "Main Product"
    }
  ]
}
{% endschema %}
