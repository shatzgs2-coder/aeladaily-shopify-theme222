<div class="search-page">
  <div class="page-width">
    {%- if search.performed -%}
      <h1 class="page-title">
        {{ 'general.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
      </h1>
    {%- else -%}
      <h1 class="page-title">{{ 'general.search.title' | t }}</h1>
    {%- endif -%}

    <!-- Search Form -->
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <div class="search-form__wrapper">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.placeholder' | t }}"
        >
        <button type="submit" class="btn btn--primary">Search</button>
      </div>
    </form>

    <!-- Search Results -->
    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <div class="collection-grid collection-grid--4">
          {%- for item in search.results -%}
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'product-card', product: item %}
              {%- when 'article' -%}
                <article class="product-card">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.image.alt | escape }}" loading="lazy" width="400">
                  {% endif %}
                  <div class="product-card__info">
                    <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p>{{ item.published_at | date: format: 'date' }}</p>
                  </div>
                </article>
              {%- when 'page' -%}
                <article class="product-card">
                  <div class="product-card__info">
                    <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p>{{ item.content | strip_html | truncatewords: 15 }}</p>
                  </div>
                </article>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          {{ paginate | default_pagination }}
        {%- endif -%}
      {%- else -%}
        <p class="search-no-results">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Main Search",
  "tag": "section",
  "class": "search-section",
  "settings": [],
  "presets": [
    {
      "name": "Main Search"
    }
  ]
}
{% endschema %}
