<section class="aw-search-page">
  <div class="aw-search-page__inner">
    <form action="{{ routes.search_url }}" method="get" role="search" class="aw-search-form">
      <input type="search"
             name="q"
             value="{{ search.terms | escape }}"
             placeholder="Search our collection..."
             class="aw-search-input"
             aria-label="Search">
      <button type="submit" class="aw-search-btn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>
    </form>

    {%- if search.performed -%}
      <p class="aw-collection-page__count" style="text-align:center;margin-bottom:32px;">
        {%- if search.results_count > 0 -%}
          Found {{ search.results_count }} result{{ search.results_count | pluralize: '', 's' }} for "{{ search.terms }}"
        {%- else -%}
          No results found for "{{ search.terms }}"
        {%- endif -%}
      </p>

      {%- if search.results_count > 0 -%}
        <div class="aw-search-results">
          {%- for item in search.results limit: 20 -%}
            <div class="aw-product-card">
              <a href="{{ item.url }}" class="aw-product-card__link">
                <div class="aw-product-card__img">
                  {%- if item.object_type == 'product' and item.featured_image -%}
                    {{ item.featured_image | image_url: width: 400 | image_tag: loading:'lazy', alt:item.title }}
                  {%- else -%}
                    <div style="display:flex;align-items:center;justify-content:center;height:100%;background:#ede8e1;color:#c4a882;font-family:'Cormorant Garamond',serif;">No Image</div>
                  {%- endif -%}
                </div>
                <div class="aw-product-card__body">
                  <p class="aw-product-card__type">{{ item.object_type | capitalize }}</p>
                  <h3 class="aw-product-card__title">{{ item.title }}</h3>
                  {%- if item.price != blank -%}<p class="aw-product-card__price">{{ item.price | money }}</p>{%- endif -%}
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="text-align:center;color:#6b5e53;padding:40px 20px;font-size:1.05rem;">
        Type above to search our wabi-sabi collection.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Search",
  "tag": "section",
  "settings": []
}
{% endschema %}
