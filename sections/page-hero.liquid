<div class="page-hero" style="--hero-bg: {{ section.settings.bg_color | default: '#F2EFE8' }}">
  <div class="page-width">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a></li>
        {%- if template contains 'product' -%}
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li aria-current="page"><span>{{ product.title }}</span></li>
        {%- elsif template contains 'collection' -%}
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li aria-current="page"><span>{{ collection.title }}</span></li>
        {%- elsif template contains 'cart' -%}
          <li aria-current="page"><span>Cart</span></li>
        {%- elsif template == 'page' -%}
          <li aria-current="page"><span>{{ page.title }}</span></li>
        {%- else -%}
          <li aria-current="page"><span>{{ page_title }}</span></li>
        {%- endif -%}
      </ol>
    </nav>
    <h1 class="page-hero__title">{{ section.settings.heading | default: page_title }}</h1>
    {% if section.settings.subtext != blank %}
      <p class="page-hero__subtext">{{ section.settings.subtext }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Page Hero",
  "tag": "section",
  "class": "page-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (leave blank to use page title)"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "bg_color",
      "default": "#F2EFE8",
      "label": "Background color"
    }
  ],
  "presets": [
    {
      "name": "Page Hero",
      "settings": {}
    }
  ]
}
{% endschema %}
