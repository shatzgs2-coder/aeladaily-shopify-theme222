<section class="aw-page-hero">
  <div class="aw-page-hero__inner aw-container" style="max-width:800px;">
    {%- if section.settings.label != blank -%}
      <p class="aw-page-hero__label">{{ section.settings.label }}</p>
    {%- endif -%}
    <h1 class="aw-page-hero__title">{{ page.title | default: collection.title | default: blog.title | default: 'Page' }}</h1>
  </div>
</section>

{% schema %}
{
  "name": "Page Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label (optional)"
    }
  ],
  "presets": [{ "name": "Page Hero", "category": "Text" }]
}
{% endschema %}
