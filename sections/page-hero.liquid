<style>
  .aw-page-hero{padding:60px 40px;text-align:center;background:var(--aw-wheat)}
  .aw-page-hero h1{margin-bottom:10px}
  .aw-page-hero p{font-size:1rem;color:var(--aw-stone);max-width:480px;margin:0 auto}
  @media(max-width:768px){.aw-page-hero{padding:48px 20px}}
</style>

<section class="aw-page-hero">
  <p class="aw-label">{{ section.settings.label }}</p>
  <h1>{{ page.title | default: collection.title | default: blog.title | default: 'Page' }}</h1>
  {% if section.settings.description != blank %}
    <p>{{ section.settings.description }}</p>
  {% endif %}
</section>

{% schema %}{ "name":"Page Hero","tag":"section","settings":[{"type":"text","id":"label","label":"Label"},{"type":"textarea","id":"description","label":"Description"}],"presets":[{"name":"Page Hero"}] }{% endschema %}
