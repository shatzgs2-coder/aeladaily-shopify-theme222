<article class="aw-article-body" style="padding:80px 40px;max-width:740px;margin:0 auto;">
  {%- if article.image != blank -%}
    <div style="margin-bottom:48px;border-radius:16px;overflow:hidden;">
      {{ article.image | image_url: width: 900 | image_tag: loading:'eager', alt:article.title }}
    </div>
  {%- endif -%}

  <header class="aw-article-meta">
    <p class="aw-label" style="text-align:left;">{{ article.published_at | date: '%B %d, %Y' }}</p>
    <h1 style="font-family:'Cormorant Garamond',serif;font-size:clamp(1.8rem,3vw,2.5rem);color:#2c2420;">{{ article.title }}</h1>
    {%- if article.excerpt != blank -%}
      <p style="font-size:1.1rem;color:#6b5e53;line-height:1.8;margin-top:12px;">{{ article.excerpt }}</p>
    {%- endif -%}
    {%- if article.author != blank -%}
      <p style="margin-top:8px;color:#8b7355;font-size:.88rem;">By {{ article.author }}</p>
    {%- endif -%}
  </header>

  <div class="aw-article-body">
    {{ article.content }}
  </div>

  <div style="margin-top:56px;padding-top:32px;border-top:1px solid #e8e3d8;">
    {% comment %} Share buttons placeholder {% endcomment %}
    <a href="/blogs/{{ blog.handle }}" class="aw-btn aw-btn--outline">&larr; Back to {{ blog.title | default: 'Blog' }}</a>
  </div>
</article>

{% schema %}
{
  "name": "Main Article",
  "tag": "section",
  "settings": []
}
{% endschema %}
