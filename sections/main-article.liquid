<style>
.aw-article{padding:64px 40px;background:#FAFAF7}
.aw-article__inner{max-width:720px;margin:0 auto}
.aw-article__meta{font-size:.8rem;color:#7A8471;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}
.aw-article h1{font-family:var(--aw-font-heading);font-size:2.2rem;font-weight:500;color:#1F1B16;margin:0 0 8px;line-height:1.3}
.aw-article__author{font-size:.9rem;color:#5C5648;margin-bottom:32px;font-weight:300}
.aw-article__image{border-radius:12px;overflow:hidden;margin-bottom:40px;aspect-ratio:16/9;background:#F2EFE8}
.aw-article__image img{width:100%;height:100%;object-fit:cover}
.aw-article__content{font-size:1.02rem;color:#5C5648;line-height:1.9;font-weight:300}
.aw-article__content p{margin-bottom:20px}
@media(max-width:768px){.aw-article{padding:48px 24px}.aw-article h1{font-size:1.6rem}}
</style>

<article class="aw-article" itemscope itemtype="http://schema.org/Article">
  <div class="aw-article__inner">
    <div class="aw-article__meta">{{ article.published_at | date: '%B %d, %Y' }}</div>
    <h1 itemprop="headline">{{ article.title }}</h1>
    {%- if article.author -%}
      <div class="aw-article__author">By {{ article.author }}</div>
    {%- endif -%}

    {%- if article.image -%}
      <div class="aw-article__image">
        {{ article.image | image_url: width: 1000 | image_tag: alt: article.title, widths: '400,600,800,1000,1400', loading: 'eager' }}
      </div>
    {%- endif -%}

    <div class="aw-article__content" itemprop="articleBody">
      {{ article.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article Detail",
  "class": "section-article",
  "presets": [{"name": "Article Detail", "category": "Blog"}]
}
{% endschema %}
