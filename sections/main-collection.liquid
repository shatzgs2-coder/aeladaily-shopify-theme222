<style>
.aw-coll{padding:64px 40px;background:#FAFAF7}
.aw-coll__inner{max-width:1280px;margin:0 auto}
.aw-coll__banner{padding:48px 0;text-align:center;margin-bottom:40px}
.aw-coll__title{font-family:var(--aw-font-heading);font-size:2.4rem;font-weight:500;color:#1F1B16;margin:0 0 8px}
.aw-coll__desc{color:#5C5648;font-size:.95rem;font-weight:300;max-width:520px;margin:0 auto}
.aw-coll__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},1fr);gap:24px}
.aw-coll__card{text-decoration:none;display:block}
.aw-coll__card-img{border-radius:12px;overflow:hidden;aspect-ratio:1/1;background:#F2EFE8;margin-bottom:12px;position:relative}
.aw-coll__card-img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.aw-coll__card:hover .aw-coll__card-img img{transform:scale(1.04)}
.aw-coll__card-title{font-family:var(--aw-font-heading);font-size:1.05rem;color:#1F1B16;margin:0 0 4px}
.aw-coll__card-price{font-weight:500;color:#1F1B16;font-size:.95rem}
.aw-coll__card-compare{text-decoration:line-through;color:#B89484;margin-left:8px;font-weight:300}
.aw-coll__empty{text-align:center;padding:80px 0;color:#5C5648}
@media(max-width:1024px){.aw-coll__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.aw-coll{padding:32px 20px}.aw-coll__grid{grid-template-columns:repeat(2,1fr);gap:16px}}
</style>

<section class="aw-coll">
  <div class="aw-coll__inner">
    <div class="aw-coll__banner">
      <h1 class="aw-coll__title">{{ collection.title | default: 'Shop All' }}</h1>
      {%- if collection.description != blank -%}
        <p class="aw-coll__desc">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="aw-coll__grid">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" class="aw-coll__card">
              <div class="aw-coll__card-img">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 500 | image_tag: alt: product.title, widths: '250,400,500,800', loading: 'lazy' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <h3 class="aw-coll__card-title">{{ product.title }}</h3>
              <span class="aw-coll__card-price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="aw-coll__card-compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div style="display:flex;justify-content:center;gap:12px;margin-top:48px">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="aw-btn aw-btn--outline">Previous</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="aw-btn aw-btn--outline">Next</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="aw-coll__empty"><p>No products found in this collection.</p></div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Listing",
  "class": "section-main-collection",
  "settings": [
    {"type": "range","id": "products_per_page","label": "Products per page","min":4,"max":48,"step":4,"default":24},
    {"type": "range","id": "columns_desktop","label": "Desktop columns","min":2,"max":4,"step":1,"default":3}
  ],
  "presets": [{"name": "Collection Listing", "category": "Collection"}]
}
{% endschema %}
