<style>
  .aw-announcement {
    background: var(--aw-dark);
    color: rgba(255,255,255,0.8);
    text-align: center;
    padding: 11px 24px;
    font-size: 0.78rem;
    letter-spacing: 1.2px;
    line-height: 1.6;
  }
  .aw-announcement a { color: var(--aw-clay); transition: color .25s; }
  .aw-announcement a:hover { color: #fff; }
</style>

{%- if section.settings.text != blank -%}
<div class="aw-announcement">
  {{ section.settings.text }}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "aw-announcement-section",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Announcement text",
      "default": "<p>Free shipping on orders over €49 across Europe — Handcrafted with love in Berlin ✦</p>"
    }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}
