{%- if section.settings.enabled -%}
<style>
  .aw-announce{display:flex;align-items:center;justify-content:center;min-height:36px;padding:6px 24px;font-size:.78rem;letter-spacing:.5px;text-align:center;text-decoration:none}
  .aw-announce a{color:inherit;text-decoration:underline;text-underline-offset:2px}
  .aw-announce a:hover{opacity:.8}
</style>
<div class="aw-announce" style="background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }}">
  {%- if section.settings.link != blank -%}
    <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
  {%- else -%}
    {{ section.settings.text }}
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "aw-announce-section",
  "settings": [
    {"type": "checkbox","id": "enabled","label": "Show bar","default": true},
    {"type": "text","id": "text","label": "Text","default": "Free shipping on orders over 50 EUR"},
    {"type": "url","id": "link","label": "Link"},
    {"type": "color","id": "bg_color","label": "Background","default": "#8B6F47"},
    {"type": "color","id": "text_color","label": "Text","default": "#FFFFFF"}
  ],
  "presets": [{"name": "Announcement Bar", "category": "Header"}]
}
{% endschema %}
