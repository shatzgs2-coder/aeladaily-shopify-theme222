<section class="aw-about">
  <div class="aw-about__inner">
    {% if section.settings.image != blank %}
      <div class="aw-about__image">
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'About' }}
      </div>
    {% endif %}

    <div style="text-align:center;">
      <p class="aw-label">{{ section.settings.label }}</p>
      <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,4vw,3.2rem);color:#2c2420;margin-bottom:28px;">{{ section.settings.title }}</h2>
      {{ section.settings.richtext }}
    </div>

    <div class="aw-about__values">
      {%- for block in section.blocks -%}
        <div class="aw-about__value">
          <div class="aw-about__value-icon">{{ block.settings.icon }}</div>
          <h4>{{ block.settings.heading }}</h4>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Content",
  "settings": [
    { "type":"text","id":"label","label":"Label","default":"About Us" },
    { "type":"text","id":"title","label":"Title","default":"Our Philosophy" },
    { "type":"richtext","id":"richtext","label":"Content" },
    { "type":"image_picker","id":"image","label":"Image" }
  ],
  "blocks":[
    {"type":"value","name":"Value","settings":[
      {"type":"text","id":"icon","label":"Icon (emoji)","default":"\270E"},
      {"type":"text","id":"heading","label":"Heading"},
      {"type":"text","id":"text","label":"Text"}
    ]}
  ],
  "presets":[{"name":"About Content","category":"Text"}]
}
{% endschema %}
