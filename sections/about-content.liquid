<section class="about-section">
  <div class="page-width">
    <div class="about-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

        {%- when 'heading' -%}
          <div class="about-intro" {{ block.shopify_attributes }}>
            <h1>{{ block.settings.title | default: page.title }}</h1>
            <p class="about-lead">{{ block.settings.lead }}</p>
          </div>

        {%- when 'text_block' -%}
          <div class="about-text-block" {{ block.shopify_attributes }}>
            {% if block.settings.heading %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}
            <div class="rte">{{ block.settings.text }}</div>
          </div>

        {%- when 'image' -%}
          <div class="about-image" {{ block.shopify_attributes }}>
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
                width="800"
                height="{{ 800 | divided_by: block.settings.image.aspect_ratio | round }}"
              >
            {% endif %}
          </div>

        {%- when 'values' -%}
          <div class="about-values" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.title | default: 'Our Values' }}</h2>
            <div class="values-grid">
              {%- for i in (1..3) -%}
                {%- assign heading = 'value_' | append: i | append: '_title' -%}
                {%- assign text = 'value_' | append: i | append: '_text' -%}
                <div class="value-card">
                  <h3>{{ block.settings[heading] }}</h3>
                  <p>{{ block.settings[text] }}</p>
                </div>
              {%- endfor -%}
            </div>
          </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Content",
  "tag": "section",
  "class": "about-section",
  "settings": [],
  "blocks": [
    {
      "type": "heading",
      "name": "Page Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "lead",
          "label": "Lead paragraph"
        }
      ]
    },
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Sub-heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text content"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "values",
      "name": "Values Grid",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Our Values",
          "label": "Section Title"
        },
        {
          "type": "text",
          "id": "value_1_title",
          "default": "Authenticity",
          "label": "Value 1 title"
        },
        {
          "type": "textarea",
          "id": "value_1_text",
          "default": "We celebrate real materials and honest craftsmanship.",
          "label": "Value 1 text"
        },
        {
          "type": "text",
          "id": "value_2_title",
          "default": "Simplicity",
          "label": "Value 2 title"
        },
        {
          "type": "textarea",
          "id": "value_2_text",
          "default": "Less but better — every piece is thoughtfully designed.",
          "label": "Value 2 text"
        },
        {
          "type": "text",
          "id": "value_3_title",
          "default": "Mindfulness",
          "label": "Value 3 title"
        },
        {
          "type": "textarea",
          "id": "value_3_text",
          "default": "We source ethically and design for longevity.",
          "label": "Value 3 text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Content",
      "blocks": [
        {"type": "heading"},
        {"type": "text_block"},
        {"type": "image"}
      ]
    }
  ]
}
{% endschema %}
