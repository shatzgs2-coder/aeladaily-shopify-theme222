<style>
  .aw-about{padding:var(--spacing-xl) 40px;background:var(--aw-cream)}
  .aw-about__inner{max-width:900px;margin:0 auto}
  .aw-about__image{border-radius:var(--radius-lg);overflow:hidden;margin-bottom:48px;box-shadow:var(--shadow-medium);aspect-ratio:16/9}
  .aw-about__content{font-size:1.05rem;color:#6b5e53;line-height:1.9;font-weight:300;max-width:720px;margin:0 auto}
  .aw-about__values{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:56px;text-align:center}
  .aw-about__value{padding:28px 20px;background:#fff;border-radius:var(--radius-sm);box-shadow:var(--shadow-soft)}
  .aw-about__value-icon{font-size:2rem;margin-bottom:12px}
  .aw-about__value h3{font-family:var(--font-heading);font-size:1.15rem;margin-bottom:8px}
  .aw-about__value p{font-size:.88rem;color:var(--aw-stone)}
  @media(max-width:768px){.aw-about{padding:var(--spacing-lg)20px}.aw-about__values{grid-template-columns:1fr}}
</style>

<section class="aw-about">
  <div class="aw-about__inner">
    <p class="aw-label" style="text-align:center">{{ section.settings.label | default: 'About Us' }}</p>
    <h1 style="text-align:center;font-family:var(--font-heading);margin-bottom:32px">{{ section.settings.heading }}</h1>

    {%- if section.settings.image != blank -%}
      <div class="aw-about__image">
        {{ section.settings.image | image_url: width: 1200 | image_tag:
          loading:'eager', alt:section.settings.heading,
          widths:'600,900,1200',
          style:'width:100%;height:100%;object-fit:cover'
        }}
      </div>
    {%- endif -%}

    <div class="aw-about__content">
      {{ page.content | default: section.settings.text }}
    </div>

    <!-- Values -->
    <div class="aw-about__values">
      {%- for block in section.blocks -%}
        <div class="aw-about__value aw-fade-up" {{ block.shopify_attributes }}>
          <div class="aw-about__value-icon">{{ block.settings.icon | default: '✦' }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}{
  "name":"About Content","tag":"section",
  "settings":[
    {"type":"text","id":"label","label":"Label","default":"Our Story"},
    {"type":"text","id":"heading","label":"Heading","default":"About Aeladaily"},
    {"type":"richtext","id":"text","label":"Default Text"},
    {"type":"image_picker","id":"image","label":"Hero Image"}
  ],
  "blocks":[{"type":"value","name":"Value Card","settings":[
    {"type":"text","id":"icon","label":"Icon (emoji)","default":"✦"},
    {"type":"text","id":"title","label":"Title","default":"Handcrafted"},
    {"type":"textarea","id":"description","label":"Description","default:"Made by hand with love."}
  ]},{"type":"value","name":"Value Card"},{"type":"value","name":"Value Card"}],
  "presets":[{"name":"About Content","category":"Text"}]
}{% endschema %}
