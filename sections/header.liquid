<style>
  .aw-header {
    padding: 0 40px;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250,247,242,0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(139,115,85,0.06);
  }
  .aw-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .aw-header__logo {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #8b7355;
    letter-spacing: 1px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .aw-header__logo:hover { color: var(--aw-dark); }
  .aw-header__logo img { height: 36px; width: auto; }
  .aw-header__menu { display: flex; gap: 36px; list-style: none; align-items: center; }
  .aw-header__menu a {
    font-size: 0.85rem;
    color: #6b5e53;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: color var(--transition-base);
  }
  .aw-header__menu a:hover,
  .aw-header__menu a.nav-link--active { color: #8b7355; }

  /* Actions */
  .aw-header__actions { display: flex; align-items: center; gap: 20px; }
  .aw-header__action-icon {
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    transition: background var(--transition-fast);
    cursor: pointer;
    color: var(--aw-charcoal);
    text-decoration: none;
  }
  .aw-header__action-icon:hover { background: var(--aw-linen); }
  .cart-count-bubble {
    position: absolute;
    top: 2px; right: 2px;
    min-width: 17px; height: 17px;
    background: var(--aw-accent);
    color: white;
    border-radius: 50%;
    font-size: 9px;
    font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    line-height: 1; padding: 0 4px;
  }

  /* Mobile */
  .mobile-menu-toggle {
    display: none; flex-direction: column; gap: 5px;
    width: 26px; padding: 4px 0; cursor: pointer; border: none; background: none;
  }
  .mobile-menu-toggle span {
    display: block; height: 1.5px; background: var(--aw-charcoal); border-radius: 2px;
  }
  .aw-mobile-nav[hidden] { display: none !important; }
  .aw-mobile-nav {
    display: none;
    background: var(--aw-linen);
    border-top: 1px solid var(--color-border);
    padding: 16px 40px;
  }
  .aw-mobile-nav-list li a {
    display: block;
    padding: 12px 0;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--aw-charcoal);
    letter-spacing: 0.5px;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .aw-header { padding: 0 20px; }
    .aw-header__menu { display: none; }
    .mobile-menu-toggle { display: flex; }
    .aw-mobile-nav { display: block; }
  }
</style>

<header class="aw-header" id="site-header">
  <div class="aw-header__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="aw-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <!-- Navigation -->
    <nav>
      <ul class="aw-header__menu">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}" class="{% if link.active %}nav-link--active{% endif %}">
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Actions -->
    <div class="aw-header__actions">
      <!-- Search -->
      <a href="{{ routes.search_url }}" class="aw-header__action-icon" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </a>

      <!-- Cart -->
      <a href="{{ routes.cart_url }}" class="aw-header__action-icon" data-cart-open aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="cart-count-bubble" style="display:none">0</span>
      </a>

      <!-- Mobile Toggle -->
      <button class="mobile-menu-toggle" aria-label="Menu" type="button">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav class="aw-mobile-nav" hidden>
    <ul class="aw-mobile-nav-list">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

<script>
document.querySelector('.mobile-menu-toggle')?.addEventListener('click', function() {
  const nav = document.querySelector('.aw-mobile-nav');
  if (nav) nav.toggleAttribute('hidden');
});
</script>

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px",
      "label": "Logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "default": true,
      "label": "Enable sticky header"
    }
  ]
}
{% endschema %}
