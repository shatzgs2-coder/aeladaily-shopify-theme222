<section class="aw-featured-coll">
  <div class="aw-featured-coll__inner">
    <p class="aw-label">{{ section.settings.label | default: "The Collection" }}</p>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,4vw,3.2rem);color:#2c2420;margin-bottom:16px;">{{ section.settings.title | default: "Curated for Your Home" }}</h2>
    <p style="font-size:1.05rem;color:#6b5e53;max-width:640px;line-height:1.8;font-weight:300;margin-bottom:48px;">{{ section.settings.description }}</p>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank -%}
      <div class="aw-featured-coll__grid">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="aw-product-card">
            <a href="{{ product.url }}" class="aw-product-card__link">
              <div class="aw-product-card__img">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 450 | image_tag: loading: 'lazy', alt: product.title }}
                {%- else -%}
                  <div style="display:flex;align-items:center;justify-content:center;height:100%;color:#c4a882;font-family:'Cormorant Garamond',serif;font-size:1.2rem">Atelier Wabi</div>
                {%- endif -%}
              </div>
              <div class="aw-product-card__body">
                <p class="aw-product-card__type">{{ product.type | default: 'Home Decor' }}</p>
                <h3 class="aw-product-card__title">{{ product.title }}</h3>
                <p class="aw-product-card__price">{{ product.price | money }}</p>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:#6b5e53;text-align:center;padding:80px 20px;">Select a collection in this section's settings.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The Collection" },
    { "type": "text", "id": "title", "label": "Title", "default": "Curated for Your Home" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 50, "step": 1, "default": 12 }
  ],
  "presets": [{ "name": "Featured Collection", "category": "Collection" }]
}
{% endschema %}
