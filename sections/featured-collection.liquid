<style>
  .aw-featured-collection { padding: var(--space-3xl) 0; background: white; }
  .aw-featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns,4),1fr);
    gap: 28px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }
</style>

<section class="aw-featured-collection">
  <div class="page-width">
    <span class="section-label">{{ section.settings.label | default: 'Curated' }}</span>
    <h2 class="section-title">{{ section.settings.title | default: 'Featured Collection' }}</h2>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank -%}
      <div class="collection-grid collection-grid--{{ section.settings.columns | default: 4 }}">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Placeholder when no collection selected -->
      <div class="aw-featured-collection__grid" style="--columns: {{ section.settings.columns | default: 4 }}; padding:0;">
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="product-card">
            <div class="product-card__image-wrapper" style="background:var(--aw-linen);"></div>
            <div class="product-card__info">
              <span class="product-card__type">Product {{ i }}</span>
              <h3>Product Name</h3>
              <p class="product-card__price">&euro;29.00</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <div style="text-align:center;margin-top:var(--space-2xl);">
        <a href="{{ collection.url }}" class="btn btn--outline">{{ section.settings.view_all_label | default: 'View All' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "class": "featured-collection-section",
  "settings": [
    {"type":"text","id":"label","default":"Curated","label":"Label"},
    {"type":"text","id":"title","default":"Featured Collection","label":"Heading"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"products_to_show","min":4,"max":12,"step":1,"default":8,"label":"Products to show"},
    {"type":"range","id":"columns","min":2,"max":5,"step":1,"default":4,"label":"Columns"},
    {"type":"checkbox","id":"show_view_all","default":true,"label":"Show View All button"},
    {"type":"text","id":"view_all_label","default":"View All Products","label":"View All button text"}
  ]
}
{% endschema %}
