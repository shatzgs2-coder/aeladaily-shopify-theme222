<div class="list-collections">
  <div class="page-width">
    <h1 class="page-title">{{ page_title }}</h1>

    <div class="collection-grid collection-grid--{{ section.settings.columns }}">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
        <a href="{{ collection.url }}" class="collection-card">
          {% if collection.image %}
            <div class="collection-card__image">
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: collection.image.aspect_ratio | round }}"
              >
            </div>
          {% elsif collection.products.first.featured_image %}
            <div class="collection-card__image">
              <img
                src="{{ collection.products.first.featured_image | image_url: width: 600 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: collection.products.first.featured_image.aspect_ratio | round }}"
              >
            </div>
          {% else %}
            <div class="collection-card__image placeholder-bg">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}

          <div class="collection-card__overlay">
            <h2>{{ collection.title }}</h2>
            <span>{{ collection.products_count }} {{ 'products.product.products' | t }}</span>
          </div>
        </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main List Collections",
  "tag": "section",
  "class": "collections-list-section",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns per row"
    }
  ],
  "presets": [
    {
      "name": "Main List Collections"
    }
  ]
}
{% endschema %}
