<section class="aw-list-collections">
  <div class="aw-list-collections__inner">
    <p class="aw-label">{{ section.settings.label | default: "Our Collections" }}</p>
    <h2 style="font-family:'Cormorant Garamond',serif;font-size:clamp(2.5rem,5vw,4rem);color:#2c2420;margin-bottom:48px;text-align:center;">{{ section.settings.title | default: "Browse Collections" }}</h2>

    <div class="aw-list-collections__grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" class="aw-list-collections__card">
            <div class="aw-list-collections__card-img">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 500 | image_tag: loading:'lazy', alt:collection.title }}
              {%- else -%}
                <div style="display:flex;align-items:center;justify-content:center;height:100%;background:#ede8e1;color:#c4a882;font-family:'Cormorant Garamond',serif;">{{ collection.title }}</div>
              {%- endif -%}
            </div>
            <div class="aw-list-collections__card-body">
              <h3 class="aw-list-collections__card-title">{{ collection.title }}</h3>
              {%- if collection.description != blank -%}
                <p class="aw-list-collections__card-desc">{{ collection.description | strip_html | truncatewords: 15 }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List Collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Our Collections" },
    { "type": "text", "id": "title", "label": "Title", "default": "Browse Collections" }
  ]
}
{% endschema %}
