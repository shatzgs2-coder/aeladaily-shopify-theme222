<style>
.aw-lc{padding:64px 40px;background:#FAFAF7}
.aw-lc__inner{max-width:1280px;margin:0 auto}
.aw-lc__title{font-family:var(--aw-font-heading);font-size:2rem;font-weight:500;color:#1F1B16;text-align:center;margin:0 0 40px}
.aw-lc__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.aw-lc__card{text-decoration:none;display:block;border-radius:12px;overflow:hidden;background:#fff;transition:transform .3s}
.aw-lc__card:hover{transform:translateY(-4px)}
.aw-lc__card-img{aspect-ratio:1/1;background:#F2EFE8;display:flex;align-items:center;justify-content:center;font-size:3rem;color:#B89484}
.aw-lc__card-img img{width:100%;height:100%;object-fit:cover}
.aw-lc__card-body{padding:20px;text-align:center}
.aw-lc__card-body h3{font-family:var(--aw-font-heading);font-size:1.1rem;color:#1F1B16;margin:0}
@media(max-width:768px){.aw-lc{padding:48px 24px}.aw-lc__grid{grid-template-columns:repeat(2,1fr);gap:16px}}
</style>

<section class="aw-lc">
  <div class="aw-lc__inner">
    <h1 class="aw-lc__title">{{ section.settings.heading }}</h1>
    <div class="aw-lc__grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' or collection.handle == 'all' -%}
          <a href="{{ collection.url }}" class="aw-lc__card">
            <div class="aw-lc__card-img">
              {%- if collection.image -%}
                {{ collection.image | image_url: width: 400 | image_tag: alt: collection.title, widths: '200,400,600', loading: 'lazy' }}
              {%- elsif collection.products.first and collection.products.first.featured_image -%}
                {{ collection.products.first.featured_image | image_url: width: 400 | image_tag: alt: collection.title, widths: '200,400,600', loading: 'lazy' }}
              {%- else -%}
                *
              {%- endif -%}
            </div>
            <div class="aw-lc__card-body">
              <h3>{{ collection.title }}</h3>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List Collections",
  "class": "section-list-collections",
  "settings": [
    {"type": "text","id": "heading","label": "Heading","default": "All Collections"}
  ],
  "presets": [{"name": "List Collections", "category": "Collection"}]
}
{% endschema %}
