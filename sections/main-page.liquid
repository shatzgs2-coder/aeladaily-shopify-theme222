<style>
.aw-page{padding:64px 40px;background:#FAFAF7;min-height:50vh}
.aw-page__inner{max-width:720px;margin:0 auto}
.aw-page h1{font-family:var(--aw-font-heading);font-size:2.2rem;font-weight:500;color:#1F1B16;margin:0 0 24px}
.aw-page__content{font-size:1.02rem;color:#5C5648;line-height:1.9;font-weight:300}
.aw-page__content p{margin-bottom:20px}
@media(max-width:768px){.aw-page{padding:48px 24px}.aw-page h1{font-size:1.6rem}}
</style>

<div class="aw-page">
  <div class="aw-page__inner">
    <h1>{{ page.title }}</h1>
    <div class="aw-page__content">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page Content",
  "class": "section-page",
  "presets": [{"name": "Default Page", "category": "Text"}]
}
{% endschema %}
