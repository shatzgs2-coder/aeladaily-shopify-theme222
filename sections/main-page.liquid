<style>
  .aw-page{padding:var(--spacing-xl) 40px;background:var(--aw-cream);min-height:50vh}
  .aw-page__inner{max-width:760px;margin:0 auto}
  .aw-page__inner h1{margin-bottom:24px}
  .aw-page__inner{font-size:1.05rem;color:#5a5048;line-height:1.9}
  .aw-page__inner p{margin-bottom:18px}
  .aw-page__inner img{max-width:100%;border-radius:var(--radius-md);margin:24px 0}
  @media(max-width:768px){.aw-page{padding:var(--spacing-lg)20px}}
</style>

<section class="aw-page">
  <div class="aw-page__inner">
    <h1>{{ page.title }}</h1>
    {{ page.content }}
  </div>
</section>

{% schema %}{ "name":"Main Page","tag":"section","settings":[],"presets":[{"name":"Page Content"}] }{% endschema %}
